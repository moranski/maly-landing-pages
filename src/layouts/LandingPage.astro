---
import StickyMobileCta from "../components/landing/StickyMobileCta.astro";
import LandingHeader from "../components/landing/LandingHeader.astro";
import "../styles/global.css";
import { env } from "cloudflare:workers";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { isValidGtmId } from "../scripts/consent-gated-gtm.js";

interface Props {
	page: {
		title: string;
		description: string;
		lang: string;
		dir: "rtl" | "ltr";
		hero: {
			primaryCta: {
				label: string;
				href: string;
			};
		};
	};
}

const { page } = Astro.props;
const gtmId = env.GTM_ID;
const validGtmId = isValidGtmId(gtmId) ? gtmId : undefined;
const emdashPage = createPublicPageContext({
	url: Astro.url,
	locale: page.lang,
	kind: "custom",
	pageType: "landing-page",
	title: page.title,
	description: page.description,
	canonical: (Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url).href,
	siteName: "מלי",
});
---

<!doctype html>
<html lang={page.lang} dir={page.dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{page.title}</title>
		<EmDashHead page={emdashPage} />
	</head>
	<body class="landing-page" data-gtm-id={validGtmId}>
		<EmDashBodyStart page={emdashPage} />
		<LandingHeader title={page.title} cta={page.hero.primaryCta} />
		<slot />
		<StickyMobileCta cta={page.hero.primaryCta} />
		<EmDashBodyEnd page={emdashPage} />
	</body>
</html>

<script>
	import { installConsentGatedGtm } from "../scripts/consent-gated-gtm.js";

	installConsentGatedGtm(window, document, document.body.dataset.gtmId);
</script>

<style is:global>
	#emprivacy-root {
		direction: rtl;
		text-align: right;
	}
</style>
