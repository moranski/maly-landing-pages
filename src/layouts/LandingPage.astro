---
import LandingFonts from "../components/LandingFonts.astro";
import { landingBackgroundStyle } from "../lib/landing/media-images";
import ParallaxBackground from "../components/demo/ParallaxBackground.astro";
import StickyMobileCta from "../components/landing/StickyMobileCta.astro";
import LandingHeader from "../components/landing/LandingHeader.astro";
import "../styles/global.css";
import "../styles/presentation.css";
import { env } from "cloudflare:workers";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import type { EditProxy } from "emdash";
import { isValidGtmId } from "../scripts/consent-gated-gtm.js";

import type { LandingPage } from "../lib/landing/normalize";
interface Props { preview?: boolean; page: LandingPage; contentId?: string; edit?: EditProxy; }
const { page, contentId, edit, preview = false } = Astro.props;
const gtmId = env.GTM_ID;
const validGtmId = isValidGtmId(gtmId) ? gtmId : undefined;
const emdashPage = createPublicPageContext({
	url: Astro.url,
	locale: page.lang,
	kind: contentId ? "content" : "custom",
	pageType: "landing-page",
	content: contentId ? { collection: "landing_pages", id: contentId } : undefined,
	title: page.title,
	description: page.description,
	canonical: new URL(Astro.url.pathname, Astro.site ?? Astro.url).href,
	siteName: page.brandName ?? page.title,
});
---

<!doctype html>
<html lang={page.lang} dir={page.dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{page.title}</title>
		{preview ? <meta name="robots" content="noindex, nofollow" /> : <EmDashHead page={emdashPage} />}
		<LandingFonts />
	</head>
	<body style={landingBackgroundStyle(!import.meta.env.DEV)} class="landing-page" data-preview={preview ? "true" : undefined} data-gtm-id={preview ? undefined : validGtmId} {...(!preview && edit ? edit : {})}>
		<ParallaxBackground />
		{!preview && <EmDashBodyStart page={emdashPage} />}
		{preview && <aside class="draft-notice"><strong>תצוגת טיוטה מקומית — לא פורסמה</strong><a href="/blocks-demo">לקטלוג האלמנטים</a></aside>}
		<LandingHeader title={page.title} titleEdit={edit?.title} brandName={page.brandName} brandTagline={page.brandTagline} brandLogo={page.brandLogo} brandLogoEdit={edit?.brand_logo} brandNameEdit={edit?.brand_name} brandTaglineEdit={edit?.brand_tagline} cta={page.hero?.primaryCta} />
		<slot />
		<footer class="landing-footer">
			<a href="https://maly-empower.com/%D7%94%D7%A6%D7%94%D7%A8%D7%AA-%D7%A0%D7%92%D7%99%D7%A9%D7%95%D7%AA/">הצהרת נגישות</a>
		</footer>
		{page.hero?.primaryCta && <StickyMobileCta cta={page.hero.primaryCta} />}
		{!preview && <EmDashBodyEnd page={emdashPage} />}
	</body>
</html>

<script>
	import { installConsentGatedGtm } from "../scripts/consent-gated-gtm.js";

	if (document.body.dataset.preview !== "true") installConsentGatedGtm(window, document, document.body.dataset.gtmId);

	// Mobile zoom and browser UI can shrink the visible viewport without
	// changing the layout viewport used by position:fixed.
	const viewport = window.visualViewport;
	if (viewport) {
		let pending = false;
		const updateConsentViewport = () => {
			pending = false;
			// Read all geometry before setting styles: each write can invalidate
			// layout, so interleaving the reads forces repeated synchronous work.
			const height = viewport.height;
			const width = viewport.width;
			const left = viewport.offsetLeft;
			const bottom = Math.max(0, window.innerHeight - height - viewport.offsetTop);
			const style = document.documentElement.style;
			style.setProperty("--consent-visible-height", `${height}px`);
			style.setProperty("--consent-visible-width", `${width}px`);
			style.setProperty("--consent-visible-left", `${left}px`);
			style.setProperty("--consent-visible-bottom", `${bottom}px`);
		};
		const scheduleUpdate = () => {
			if (pending) return;
			pending = true;
			requestAnimationFrame(updateConsentViewport);
		};
		viewport.addEventListener("resize", scheduleUpdate);
		viewport.addEventListener("scroll", scheduleUpdate);
		window.addEventListener("resize", scheduleUpdate);
		updateConsentViewport();
	}
</script>

<style is:global>
 /* Co-authored-by: Codex <codex@openai.com> */
 body.landing-page:has(> .landing-footer) > main { padding-block-end: 2rem; }
 .landing-footer { width: min(100%, 512px); margin-inline: auto; padding: 0 16px calc(132px + env(safe-area-inset-bottom)); }
 .landing-footer a { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 12px 20px; border-radius: 12px; background: var(--surface-ivory); color: var(--color-ink); text-decoration: underline; text-underline-offset: .2em; }
 .draft-notice { width: min(100%, 512px); padding: 80px 16px 0; margin-inline: auto; display: grid; gap: 8px; font-size: 14px; }
 .draft-notice + .site-header + main { padding-block-start: 24px; }
	#emprivacy-root {
		direction: rtl;
		text-align: right;
	}
	#emprivacy-root .emprivacy-bar {
		max-height: calc(var(--consent-visible-height, 100dvh) - 24px);
		left: var(--consent-visible-left, 0px);
		right: auto;
		width: var(--consent-visible-width, 100%);
		bottom: var(--consent-visible-bottom, 0px);
		box-sizing: border-box;
	}
	#emprivacy-root .emprivacy-title { color: var(--emprivacy-text); }
	#emprivacy-root .emprivacy-actions {
		position: sticky;
		bottom: 0;
		background: var(--emprivacy-bg);
		padding-block: 8px;
	}
	#emprivacy-root .emprivacy-btn { min-height: 44px; }
</style>
