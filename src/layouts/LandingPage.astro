---
import ParallaxBackground from "../components/demo/ParallaxBackground.astro";
import StickyMobileCta from "../components/landing/StickyMobileCta.astro";
import LandingHeader from "../components/landing/LandingHeader.astro";
import "../styles/global.css";
import "../styles/presentation.css";
import { env } from "cloudflare:workers";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import type { EditProxy } from "emdash";
import { isValidGtmId } from "../scripts/consent-gated-gtm.js";

interface Props {
	preview?: boolean;
	presentation?: boolean;
	page: {
		title: string;
		description: string;
		lang: string;
		dir: "rtl" | "ltr";
		hero: {
			primaryCta: {
				label: string;
				href: string;
			};
		};
	};
	contentId?: string;
	edit?: EditProxy;
}

const { page, contentId, edit, preview = false, presentation = preview } = Astro.props;
const gtmId = env.GTM_ID;
const validGtmId = isValidGtmId(gtmId) ? gtmId : undefined;
const emdashPage = createPublicPageContext({
	url: Astro.url,
	locale: page.lang,
	kind: contentId ? "content" : "custom",
	pageType: "landing-page",
	content: contentId ? { collection: "landing_pages", id: contentId } : undefined,
	title: page.title,
	description: page.description,
	canonical: (Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url).href,
	siteName: "מלי",
});
---

<!doctype html>
<html lang={page.lang} dir={page.dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{page.title}</title>
		{preview ? <meta name="robots" content="noindex, nofollow" /> : <EmDashHead page={emdashPage} />}
		{presentation && <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap" />}
	</head>
	<body id={presentation ? "presentation-review" : undefined} class:list={["landing-page", presentation && "presentation-review"]} data-preview={preview ? "true" : undefined} data-gtm-id={preview ? undefined : validGtmId} {...(!preview && edit ? edit : {})}>
		{presentation && <ParallaxBackground />}
		{!preview && <EmDashBodyStart page={emdashPage} />}
		{preview && <aside class="draft-notice"><strong>תצוגת טיוטה מקומית — לא פורסמה</strong><a href="/blocks-demo">לקטלוג האלמנטים</a></aside>}
		<LandingHeader title={page.title} titleEdit={edit?.title} cta={page.hero.primaryCta} />
		<slot />
		<StickyMobileCta cta={page.hero.primaryCta} />
		{!preview && <EmDashBodyEnd page={emdashPage} />}
	</body>
</html>

<script>
	import { installConsentGatedGtm } from "../scripts/consent-gated-gtm.js";

	if (document.body.dataset.preview !== "true") installConsentGatedGtm(window, document, document.body.dataset.gtmId);

	// Mobile zoom and browser UI can shrink the visible viewport without
	// changing the layout viewport used by position:fixed.
	const viewport = window.visualViewport;
	if (viewport) {
		let pending = false;
		const updateConsentViewport = () => {
			pending = false;
			const style = document.documentElement.style;
			style.setProperty("--consent-visible-height", `${viewport.height}px`);
			style.setProperty("--consent-visible-width", `${viewport.width}px`);
			style.setProperty("--consent-visible-left", `${viewport.offsetLeft}px`);
			style.setProperty("--consent-visible-bottom", `${Math.max(0, window.innerHeight - viewport.height - viewport.offsetTop)}px`);
		};
		const scheduleUpdate = () => {
			if (pending) return;
			pending = true;
			requestAnimationFrame(updateConsentViewport);
		};
		viewport.addEventListener("resize", scheduleUpdate);
		viewport.addEventListener("scroll", scheduleUpdate);
		window.addEventListener("resize", scheduleUpdate);
		updateConsentViewport();
	}
</script>

<style is:global>
 .draft-notice { width: min(100%, 512px); padding: 80px 16px 0; margin-inline: auto; display: grid; gap: 8px; font-size: 14px; }
 .draft-notice + .site-header + main { padding-block-start: 24px; }
	#emprivacy-root {
		direction: rtl;
		text-align: right;
	}
	#emprivacy-root .emprivacy-bar {
		max-height: calc(var(--consent-visible-height, 100dvh) - 24px);
		left: var(--consent-visible-left, 0px);
		right: auto;
		width: var(--consent-visible-width, 100%);
		bottom: var(--consent-visible-bottom, 0px);
		box-sizing: border-box;
	}
	#emprivacy-root .emprivacy-title { color: var(--emprivacy-text); }
	#emprivacy-root .emprivacy-actions {
		position: sticky;
		bottom: 0;
		background: var(--emprivacy-bg);
		padding-block: 8px;
	}
	#emprivacy-root .emprivacy-btn { min-height: 44px; }
</style>
