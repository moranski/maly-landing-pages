---
// Co-authored-by: Codex <codex@openai.com>
import LandingFonts from "./LandingFonts.astro";
import RichTextContent from "./landing/RichTextContent.astro";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import type { CmsPage } from "../lib/cms-page";
import type { EditProxy } from "emdash";
import "../styles/global.css";
import "../styles/presentation.css";
interface Props { page: CmsPage; contentId?: string; preview?: boolean; edit?: EditProxy; }
const { page, contentId, preview = false, edit } = Astro.props;
const context = createPublicPageContext({ url: Astro.url, locale: page.lang, kind: contentId ? "content" : "custom", pageType: "page", content: contentId ? { collection: "pages", id: contentId } : undefined, title: page.title, canonical: new URL(Astro.url.pathname, Astro.site ?? Astro.url).href });
---
<!doctype html>
<html lang={page.lang} dir={page.dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>{page.title}</title>
		<LandingFonts />
		{preview ? <meta name="robots" content="noindex, nofollow" /> : <EmDashHead page={context} />}
	</head>
	<body class="landing-page cms-page" {...(edit ?? {})}>
		{!preview && <EmDashBodyStart page={context} />}
		<main>
			<article>
				<h1 {...edit?.title}>{page.title}</h1>
				<RichTextContent body={page.body} />
			</article>
		</main>
		{!preview && <EmDashBodyEnd page={context} />}
	</body>
</html>
<style is:global>
	body.cms-page { background: var(--surface-ivory); }
	body.cms-page main { width: min(100%, 960px); min-height: 0; padding: 32px 20px; }
	body.cms-page article { padding: clamp(20px, 4vw, 48px); background: white; border: 1px solid var(--color-border); border-radius: var(--radius-card); }
	body.cms-page h1 { margin: 0 0 24px; font-size: clamp(28px, 4vw, 40px); }
</style>
