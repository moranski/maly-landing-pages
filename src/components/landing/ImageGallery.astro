---
// Co-authored-by: Codex <codex@openai.com>
import { responsiveMediaImage } from "../../lib/landing/media-images";
interface ImageItem {
	src: string;
	alt: string;
	caption?: string;
	width?: number;
	height?: number;
}

interface Props {
	images: ImageItem[];
}

const { images } = Astro.props;
// Keep the existing 416px fallback when CMS source dimensions are unknown.
const widths = (image: ImageItem) => image.width ? [224, 320, 416, 480, 560, 640, 832] : [224, 320, 416, 640, 832];
---

<div class="image-gallery">
	{
		images.map((image) => (
			<figure>
				<img {...responsiveMediaImage(image.src, widths(image), "auto, (min-width: 1200px) 499px, (min-width: 1024px) calc((100vw - 202px) / 2), (min-width: 512px) 416px, calc(100vw - 96px)", !import.meta.env.DEV, image.width)} alt={image.alt} width="1599" height="899" loading="lazy" decoding="async" />
				{image.caption && <figcaption>{image.caption}</figcaption>}
			</figure>
		))
	}
</div>

<style>
	@layer landing-components {
	.image-gallery {
		width: 100%;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-3);
	}

	.image-gallery figure {
		margin: 0;
		padding: 0.625rem;
		border: 1px solid var(--color-border);
		border-radius: 16px;
		background: white;
		box-shadow: var(--shadow-soft);
	}


	.image-gallery img {
		width: 100%;
		aspect-ratio: 1599 / 899;
		object-fit: cover;
		border-radius: 10px;
	}

	.image-gallery figcaption {
		margin-block-start: var(--space-3);
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		text-align: center;
	}
	}
</style>
