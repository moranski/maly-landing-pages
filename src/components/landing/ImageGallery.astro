---
interface ImageItem {
	src: string;
	alt: string;
	caption?: string;
}

interface Props {
	images: ImageItem[];
}

const { images } = Astro.props;
---

<div class="image-gallery">
	{
		images.map((image) => (
			<figure>
				<img src={image.src} alt={image.alt} width="1599" height="899" loading="lazy" decoding="async" />
				{image.caption && <figcaption>{image.caption}</figcaption>}
			</figure>
		))
	}
</div>

<style>
	.image-gallery {
		width: 100%;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-3);
	}

	.image-gallery figure {
		margin: 0;
		padding: 0.625rem;
		border: 1px solid var(--color-border);
		border-radius: 16px;
		background: white;
		box-shadow: var(--shadow-soft);
	}


	.image-gallery img {
		width: 100%;
		aspect-ratio: 1599 / 899;
		object-fit: cover;
		border-radius: 10px;
	}

	.image-gallery figcaption {
		margin-block-start: var(--space-3);
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		text-align: center;
	}
</style>
