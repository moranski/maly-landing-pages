---
// Co-authored-by: Codex <codex@openai.com>
import RichTextContent from "./RichTextContent.astro";
import HeroFacts from "./HeroFacts.astro";
import type { Hero } from "../../lib/landing/normalize";
import { responsiveMediaImage } from "../../lib/landing/media-images";
interface PageData { hero?: Hero; }

interface Props {
	page: PageData;
	layoutEdit?: Partial<{ "data-emdash-ref": string }>;
}

const { page, layoutEdit } = Astro.props;
const hero = page.hero;
const heroVisual = hero?.visual;
---

<main id="top" {...layoutEdit}>
	{hero && <section class="hero">
		<div class="hero__inner">
			<div class="hero__copy">
				{hero.eyebrow && <p class="kicker">{hero.eyebrow}</p>}
				<h1>{hero.title}</h1>
				<p class="hero__subtitle"><strong>{hero.subtitle}</strong></p>
				<div class="hero__body">
					<RichTextContent body={hero.body} />
				</div>
				<HeroFacts items={hero.facts} />
			</div>

			{heroVisual && <div class="hero__visual">
				<div class="course-preview">
					<img
						class="course-preview__image"
						{...responsiveMediaImage(heroVisual.src, [224, 320, 402, 480, 560, 640, 804, 960, 1120], "(min-width: 1504px) 551px, (min-width: 1024px) calc((100vw - 188px) / 2.25 - 34px), (min-width: 512px) 402px, calc(100vw - 110px)", !import.meta.env.DEV, heroVisual.width)}
						alt={heroVisual.alt}
						width="1599"
						height="899"
						loading="eager"
						decoding="async"
					/>
					{(heroVisual.title || heroVisual.caption) && <div class="course-preview__caption">
						{heroVisual.title && <strong>{heroVisual.title}</strong>}
						{heroVisual.caption && <span>{heroVisual.caption}</span>}
					</div>}
				</div>
			</div>}
			{(hero.primaryCta || hero.secondaryCta) && <div class="hero__actions">
				{hero.primaryCta && <a class="button button--primary" data-cta-style={hero.primaryCta.style} href={hero.primaryCta.href}>{hero.primaryCta.label}</a>}
				{hero.secondaryCta && <a class="button button--secondary" data-cta-style={hero.secondaryCta.style} href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>}
			</div>
		}
		</div>
	</section>}

	<slot />
</main>

<style>
	@layer landing-components {
	.hero {
		position: relative;
		padding: 0;
		background: var(--color-surface);
		text-align: start;
	}

	.hero .kicker {
		margin: 0;
		background: color-mix(in srgb, var(--color-accent-soft) 65%, white);
		color: var(--color-accent-strong);
	}

	.hero__inner {
		width: min(100%, var(--layout-width));
		margin-inline: auto;
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-5);
		align-items: center;
	}

	.hero__copy {
		display: grid;
		justify-items: start;
		gap: var(--space-2);
	}

	.hero h1 {
		max-width: 100%;
		margin: 0;
		font-weight: 800;
		font-size: clamp(1.8rem, 1.55rem + 1.5vw, 2rem);
		line-height: 1.25;
	}

	.hero__subtitle {
		max-width: 100%;
		margin: var(--space-2) 0;
		color: var(--color-accent-strong);
		font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.625rem);
		line-height: 1.4;
		font-weight: 800;
	}

	.hero__body {
		max-width: 100%;
		margin-block-start: var(--space-2);
	}

	.hero__body p {
		margin: 0;
	}

	.hero__body p + p {
		margin-block-start: var(--space-4);
	}

	.hero__actions {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-2);
		margin-block-start: var(--space-2);
	}

	.hero__visual {
		min-height: 0;
		display: grid;
		place-items: center;
	}

	.course-preview {
		position: relative;
		width: 100%;
		padding: 0;
		border: 0;
		border-radius: 16px;
		background: var(--color-surface-warm);
		box-shadow: var(--shadow-soft);
		overflow: hidden;
	}

	.course-preview::before {
		content: none;
	}

	.course-preview__image {
		width: 100%;
		aspect-ratio: 16 / 9;
		max-height: 14rem;
		object-fit: cover;
		border-radius: 0;
	}

	.course-preview__caption {
		display: grid;
		gap: 0.2rem;
		position: absolute;
		inset-inline: 0;
		inset-block-end: 0;
		margin: 0;
		padding: var(--space-3);
		background: linear-gradient(0deg, color-mix(in srgb, var(--color-ink) 88%, transparent), transparent);
		color: white;
		text-align: start;
	}

	.course-preview__caption strong {
		color: white;
		font-size: 0.8rem;
	}

	.course-preview__caption span {
		color: color-mix(in srgb, white 88%, transparent);
		font-size: 0.75rem;
	}

	.hero__actions .button { width: 100%; justify-content: center; }
	}
</style>
