---
interface PageData {
	title: string;
	description: string;
	hero: {
		eyebrow?: string;
		title: string;
		subtitle: string;
		body: string[];
		primaryCta: { label: string; href: string };
		secondaryCta?: { label: string; href: string };
		visual: {
			src: string;
			alt: string;
			title: string;
			caption: string;
		};
	};
}

interface Props {
	page: PageData;
}

const { page } = Astro.props;
const heroVisual = page.hero.visual;
---

<main id="top">
	<section class="hero">
		<div class="hero__inner">
			<div class="hero__copy">
				{page.hero.eyebrow && <p class="kicker">{page.hero.eyebrow}</p>}
				<h1>{page.hero.title}</h1>
				<p class="hero__subtitle">{page.hero.subtitle}</p>
				<div class="hero__body">
					{page.hero.body.map((paragraph) => <p>{paragraph}</p>)}
				</div>
			</div>

			<div class="hero__visual">
				<div class="course-preview">
					<img
						class="course-preview__image"
						src={heroVisual.src}
						alt={heroVisual.alt}
						width="1599"
						height="899"
						loading="eager"
						decoding="async"
					/>
					<div class="course-preview__caption">
						<strong>{heroVisual.title}</strong>
						<span>{heroVisual.caption}</span>
					</div>
				</div>
			</div>
			<div class="hero__actions">
				<a class="button button--primary" href={page.hero.primaryCta.href}>{page.hero.primaryCta.label}</a>
				{page.hero.secondaryCta && <a class="button button--secondary" href={page.hero.secondaryCta.href}>{page.hero.secondaryCta.label}</a>}
			</div>
		</div>
	</section>

	<slot />
</main>

<style>
	.hero {
		position: relative;
		padding: 0;
		background: var(--color-surface);
		text-align: start;
	}

	.hero .kicker {
		display: inline-flex;
		margin: 0;
		padding: 0.3rem 0.75rem;
		border-radius: var(--radius-pill);
		background: color-mix(in srgb, var(--color-accent-soft) 65%, white);
		color: var(--color-accent-strong);
		font-size: 0.75rem;
		font-weight: 600;
	}

	.hero__inner {
		width: min(100%, var(--layout-width));
		margin-inline: auto;
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-5);
		align-items: center;
	}

	.hero__copy {
		display: grid;
		justify-items: start;
		gap: var(--space-2);
	}

	.hero h1 {
		max-width: 100%;
		margin: 0;
		font-weight: 800;
		font-size: clamp(1.8rem, 1.55rem + 1.5vw, 2rem);
		line-height: 1.25;
	}

	.hero__subtitle {
		max-width: 100%;
		margin: 0;
		color: var(--color-text-muted);
		font-size: 1rem;
		line-height: 1.65;
		font-weight: 400;
	}

	.hero__body {
		max-width: 100%;
		margin-block-start: var(--space-2);
	}

	.hero__body p {
		margin: 0;
	}

	.hero__body p + p {
		margin-block-start: var(--space-4);
	}

	.hero__actions {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-2);
		margin-block-start: var(--space-2);
	}

	.hero__visual {
		min-height: 0;
		display: grid;
		place-items: center;
	}

	.course-preview {
		position: relative;
		width: 100%;
		padding: 0;
		border: 0;
		border-radius: 16px;
		background: var(--color-surface-warm);
		box-shadow: var(--shadow-soft);
		overflow: hidden;
	}

	.course-preview::before {
		content: none;
	}

	.course-preview__image {
		width: 100%;
		aspect-ratio: 16 / 9;
		max-height: 14rem;
		object-fit: cover;
		border-radius: 0;
	}

	.course-preview__caption {
		display: grid;
		gap: 0.2rem;
		position: absolute;
		inset-inline: 0;
		inset-block-end: 0;
		margin: 0;
		padding: var(--space-3);
		background: linear-gradient(0deg, color-mix(in srgb, var(--color-ink) 88%, transparent), transparent);
		color: white;
		text-align: start;
	}

	.course-preview__caption strong {
		color: white;
		font-size: 0.8rem;
	}

	.course-preview__caption span {
		color: color-mix(in srgb, white 88%, transparent);
		font-size: 0.75rem;
	}

	.hero__actions .button { width: 100%; justify-content: center; }
</style>
