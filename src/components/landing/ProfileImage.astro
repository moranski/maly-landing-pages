---
interface Props {
	src: string;
	alt: string;
	caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="profile-image">
	<div class="profile-image__frame">
		<img src={src} alt={alt} width="572" height="577" loading="lazy" decoding="async" />
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.profile-image {
		margin: 0;
		display: grid;
		justify-items: center;
		gap: var(--space-3);
	}

	.profile-image__frame {
		width: min(100%, 176px);
		aspect-ratio: 1;
		display: grid;
		place-items: end center;
		overflow: hidden;
		border: 4px solid color-mix(in srgb, var(--color-ink) 16%, white);
		border-radius: 50%;
		background: var(--color-surface-warm);
		box-shadow: var(--shadow-lift);
	}

	.profile-image img {
		width: 96%;
		height: 96%;
		object-fit: contain;
		object-position: center bottom;
	}

	.profile-image figcaption {
		max-width: 100%;
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 500;
		text-align: center;
	}
</style>
