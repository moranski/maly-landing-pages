---
// Co-authored-by: Codex <codex@openai.com>
import { responsiveMediaImage } from "../../lib/landing/media-images";
interface Props {
	src: string;
	alt: string;
	caption?: string;
	width?: number;
	height?: number;
	variant?: "default" | "editorial";
}

const { src, alt, caption, width: originalWidth, height: originalHeight, variant = "default" } = Astro.props;
---

<figure class:list={["profile-image", `profile-image--${variant}`]}>
	<div class="profile-image__frame">
		<img {...responsiveMediaImage(src, variant === "editorial" ? [320, 640] : [168, 336], variant === "editorial" ? "320px" : "168px", !import.meta.env.DEV, originalWidth)} alt={alt} width={originalWidth ?? 572} height={originalHeight ?? 577} loading="lazy" decoding="async" />
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	@layer landing-components {
	.profile-image {
		margin: 0;
		display: grid;
		justify-items: center;
		gap: var(--space-3);
	}

	.profile-image__frame {
		width: min(100%, 176px);
		aspect-ratio: 1;
		display: grid;
		place-items: end center;
		overflow: hidden;
		border: 4px solid color-mix(in srgb, var(--color-ink) 16%, white);
		border-radius: 50%;
		background: var(--color-surface-warm);
		box-shadow: var(--shadow-lift);
	}

	.profile-image--editorial { width: min(100%, 360px); justify-self: center; }
	.profile-image--editorial .profile-image__frame {
		width: 100%;
		aspect-ratio: auto;
		display: block;
		border: 1px solid var(--color-border);
		border-radius: 24px;
		background: white;
		box-shadow: var(--shadow-soft);
	}
	.profile-image--editorial img {
		width: 100%;
		height: auto;
		object-fit: contain;
		object-position: center;
		border-radius: 23px;
	}

	.profile-image img {
		width: 96%;
		height: 96%;
		object-fit: contain;
		object-position: center bottom;
	}

	.profile-image figcaption {
		max-width: 100%;
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 500;
		text-align: center;
	}
	}
</style>
