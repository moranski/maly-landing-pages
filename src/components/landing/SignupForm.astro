---
// Co-authored-by: Codex <codex@openai.com>
import { env } from "cloudflare:workers";
import type { CtaStyle } from "../../lib/landing/normalize";

interface Props {
	submitLabel: string;
	ctaStyle?: CtaStyle;
	checkoutUrl?: string;
	preview?: boolean;
}

const { submitLabel, ctaStyle, checkoutUrl, preview = false } = Astro.props;
const siteKey = env.TURNSTILE_SITE_KEY;
const enabled = Boolean(!preview && siteKey && checkoutUrl);
---

{(enabled || preview) ? (
	<form class="signup-form" method="post" action="/api/signup" data-signup-form={enabled ? "reading" : undefined} data-checkout-url={enabled ? checkoutUrl : undefined}>
		<label for="signup-name">שם מלא</label>
		<input id="signup-name" name="name" type="text" autocomplete="name" maxlength="120" required disabled={preview} />

		<label for="signup-phone">מספר טלפון</label>
		<input id="signup-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="24" dir="ltr" placeholder="05X-XXXXXXX" required disabled={preview} aria-describedby="signup-phone-hint" />
		<small id="signup-phone-hint">יש להזין מספר ישראלי תקין, למשל 050-1234567 או ‎+972-50-1234567.</small>

		<label for="signup-email">כתובת אימייל</label>
		<input id="signup-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" dir="ltr" required disabled={preview} />

		<label class="signup-form__consent">
			<input name="consent" type="checkbox" required checked disabled={preview} />
			<span>אני מסכים/ה שיצרו איתי קשר עם הצעות</span>
		</label>

		{enabled && <div class="signup-form__trap" aria-hidden="true">
			<label for="signup-website">אתר</label>
			<input id="signup-website" name="website" type="text" tabindex="-1" autocomplete="off" />
		</div>}

		{enabled && <div id="signup-turnstile" class="cf-turnstile" data-sitekey={siteKey} data-action="signup_reading" data-language="he" data-size="compact" data-execution="execute" data-appearance="interaction-only" data-callback="onSignupTurnstileSuccess" data-error-callback="onSignupTurnstileError" data-timeout-callback="onSignupTurnstileError" data-retry="never" data-refresh-timeout="manual" data-response-field="false"></div>}
		<button class="button button--primary" data-cta-style={ctaStyle} type="submit" disabled>{submitLabel}</button>
		<p class="signup-form__status" data-signup-status role="status" aria-live="polite"></p>
	</form>
) : (
	<p role="status">הטופס אינו זמין כרגע. אפשר לנסות שוב מאוחר יותר.</p>
)}
{enabled && <noscript><p>כדי לשלוח את הטופס, יש להפעיל JavaScript בדפדפן.</p></noscript>}

<style>
	.signup-form {
		display: grid;
		gap: var(--space-3);
		min-width: 0;
		text-align: start;
	}

	.signup-form > label:not(.signup-form__consent) {
		font-size: 0.875rem;
		font-weight: 600;
	}

	.signup-form > input {
		width: 100%;
		min-width: 0;
		min-height: 48px;
		padding: var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		background: var(--color-surface-warm);
		color: var(--color-text);
		font: inherit;
	}

	.signup-form__consent {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-2);
		align-items: start;
		margin-block: var(--space-2);
		font-size: 0.8125rem;
		line-height: 1.5;
	}

	.signup-form__consent input {
		width: 1.125rem;
		height: 1.125rem;
		margin: 0.1rem 0 0;
		accent-color: var(--color-accent);
	}

	.signup-form :focus-visible {
		outline: 3px solid var(--color-accent);
		outline-offset: 3px;
	}

	.signup-form__trap {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.signup-form__status:empty { display: none; }
	.signup-form__status { margin: 0; color: var(--color-text); }

	.signup-form .cf-turnstile {
		max-width: 100%;
		overflow: hidden;
	}
</style>

<script>
	import { normalizeIsraeliPhone, normalizeSignupDetails } from "../../lib/landing/signup-details";
	import { readingCheckoutUrl } from "../../lib/landing/urls";
	import { reportReadingMetaEvent } from "../../scripts/reading-meta-events";

	interface TurnstileApi {
		execute: (widgetId: string) => void;
		reset: (widgetId: string) => void;
	}
	interface SignupWindow extends Window {
		turnstile?: TurnstileApi;
		onSignupTurnstileSuccess?: (token: string) => void;
		onSignupTurnstileError?: () => void;
	}

	const messages: Record<string, string> = {
		invalid_input: "נא לבדוק את השם, מספר הטלפון, כתובת האימייל וההסכמה לקבלת הצעות.",
		verification_failed: "בדיקת האבטחה נכשלה. נא לנסות שוב.",
		rate_limited: "נשלחו יותר מדי בקשות. נא להמתין מעט ולנסות שוב.",
	};

	function connectSignupForm(form: HTMLFormElement) {
		const name = form.querySelector<HTMLInputElement>('input[name="name"]');
		const phone = form.querySelector<HTMLInputElement>('input[name="phone"]');
		const email = form.querySelector<HTMLInputElement>('input[name="email"]');
		const consent = form.querySelector<HTMLInputElement>('input[name="consent"]');
		const website = form.querySelector<HTMLInputElement>('input[name="website"]');
		const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		const status = form.querySelector<HTMLElement>("[data-signup-status]");
		const funnel = form.dataset.signupForm;
		const checkoutUrl = form.dataset.checkoutUrl;
		if (!name || !phone || !email || !consent || !website || !submit || !status || !funnel || !checkoutUrl) return;

		const signupWindow = window as SignupWindow;
		const widget = "#signup-turnstile";
		let waitingForTurnstile = false;
		let busy = false;
		let turnstileLoadFailed = false;

		const syncButton = () => { submit.disabled = busy || !consent.checked; };
		const reset = () => {
			waitingForTurnstile = false;
			busy = false;
			syncButton();
			signupWindow.turnstile?.reset(widget);
		};
		const validatePhone = () => {
			phone.setCustomValidity(!phone.value || normalizeIsraeliPhone(phone.value) ? "" : "נא להזין מספר טלפון ישראלי תקין.");
		};
		consent.addEventListener("change", syncButton);
		phone.addEventListener("input", validatePhone);
		phone.addEventListener("blur", () => {
			phone.value = normalizeIsraeliPhone(phone.value) ?? phone.value;
			validatePhone();
		});
		window.addEventListener("pageshow", event => {
			if (event.persisted && busy) {
				status.textContent = "";
				reset();
			}
			syncButton();
		});
		syncButton();

		signupWindow.onSignupTurnstileError = () => {
			if (!waitingForTurnstile) return;
			status.textContent = messages.verification_failed;
			reset();
		};

		signupWindow.onSignupTurnstileSuccess = async (turnstileToken) => {
			if (!waitingForTurnstile) return;
			waitingForTurnstile = false;
			const details = normalizeSignupDetails({ name: name.value, phone: phone.value, email: email.value });
			const destination = details && readingCheckoutUrl(checkoutUrl, details);
			if (!consent.checked || !details || !destination || !form.reportValidity()) {
				status.textContent = messages.invalid_input;
				reset();
				return;
			}

			status.textContent = "שולחים את הפרטים…";
			try {
				const response = await fetch(form.action, {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ ...details, funnel, consent: true, website: website.value, turnstileToken }),
				});
				const result = await response.json() as { checkoutAllowed?: boolean; error?: string };
				if (result.checkoutAllowed === true) {
					status.textContent = "מעבירים לעמוד התשלום…";
					reportReadingMetaEvent("CheckoutClick");
					window.location.assign(destination);
					return;
				}
				status.textContent = messages[result.error ?? ""] ?? "לא הצלחנו לשלוח את הטופס. נא לנסות שוב.";
			} catch {
				status.textContent = "לא הצלחנו לשלוח את הטופס. נא לבדוק את החיבור ולנסות שוב.";
			}
			reset();
		};

		form.addEventListener("submit", event => {
			event.preventDefault();
			if (busy || !consent.checked) return;
			validatePhone();
			if (!form.reportValidity()) return;
			if (!normalizeSignupDetails({ name: name.value, phone: phone.value, email: email.value })) {
				status.textContent = messages.invalid_input;
				return;
			}
			if (!signupWindow.turnstile) {
				status.textContent = turnstileLoadFailed
					? "בדיקת האבטחה לא נטענה. נא לרענן את העמוד ולנסות שוב."
					: "בדיקת האבטחה עדיין נטענת. נא לנסות שוב בעוד רגע.";
				return;
			}
			waitingForTurnstile = true;
			busy = true;
			syncButton();
			status.textContent = "בודקים את הבקשה…";
			try {
				signupWindow.turnstile.execute(widget);
			} catch {
				status.textContent = messages.verification_failed;
				reset();
			}
		});

		// The widget resolves its named callbacks when it renders.
		const script = document.createElement("script");
		script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
		script.addEventListener("error", () => { turnstileLoadFailed = true; });
		document.head.append(script);
	}

	const form = document.querySelector<HTMLFormElement>("[data-signup-form]");
	if (form) connectSignupForm(form);
</script>
