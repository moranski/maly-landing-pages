---
import type { HeroFact } from "../../lib/landing/normalize";

interface Props { items: HeroFact[] }
const { items } = Astro.props;
---
{items.length > 0 && <ul class="hero-facts" aria-label="פרטי התוכנית">
	{items.map(({ icon, value, label }) => <li class="hero-fact">
		<span class="hero-fact__icon" aria-hidden="true">
			{icon === "calendar" && <svg viewBox="0 0 24 24" fill="none"><rect x="3.5" y="5" width="17" height="16" rx="2.5" stroke="currentColor" stroke-width="1.8"/><path d="M7.5 3.5v3M16.5 3.5v3M4 9.5h16M8 13h2m4 0h2M8 16.5h2m4 0h2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>}
			{icon === "notebook" && <svg viewBox="0 0 24 24" fill="none"><path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H20v18H7.5A2.5 2.5 0 0 0 5 22V4.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M5 5H3m2 4H3m2 4H3m2 4H3m4-13v15m4-12h6m-6 4h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>}
			{icon === "stopwatch" && <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="13" r="8" stroke="currentColor" stroke-width="1.8"/><path d="M12 9v4l2.5 1.5M9 2h6m-3 0v3m6.2 1.8 1.4-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>}
		</span>
		<span class="hero-fact__copy"><strong>{value}</strong><span>{label}</span></span>
	</li>)}
</ul>}

<style>
	@layer landing-components {
	.hero-facts {
		width: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
	}
	.hero-fact {
		min-width: 0;
		min-height: 104px;
		padding: 12px 8px;
		display: grid;
		align-content: center;
		justify-items: center;
		gap: 8px;
		border: 1px solid rgb(0 35 111 / .12);
		border-radius: 16px;
		background: rgb(255 255 255 / .76);
		text-align: center;
	}
	.hero-fact__icon { width: 24px; height: 24px; color: #00236f; }
	.hero-fact__icon svg { display: block; width: 100%; height: 100%; }
	.hero-fact__copy { display: grid; gap: 2px; line-height: 1.3; }
	.hero-fact__copy strong { color: #00236f; font-size: 18px; font-weight: 700; }
	.hero-fact__copy > span { color: #444651; font-size: 14px; }
	@media (max-width: 359px) {
		.hero-facts { grid-template-columns: 1fr; gap: 8px; }
		.hero-fact { min-height: 56px; padding: 8px 12px; display: flex; justify-items: initial; text-align: start; }
		.hero-fact__icon { flex: 0 0 24px; }
		.hero-fact__copy { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; }
	}
	@media (min-width: 1024px) {
		.hero-fact { min-height: 112px; padding: 14px 10px; }
		.hero-fact__copy strong { font-size: 22px; }
		.hero-fact__copy > span { font-size: 16px; }
	}
	}
</style>

