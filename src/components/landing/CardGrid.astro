---
interface Item {
	title: string;
	body: string;
}

interface Props {
	items: Item[];
	ordered?: boolean;
}

const { items, ordered = false } = Astro.props;
---

<div class="card-grid">
	{
		items.map((item, index) => (
			<article class="info-card">
				{ordered && <span class="info-card__index">{index + 1}</span>}
				<h3>{item.title}</h3>
				<p>{item.body}</p>
			</article>
		))
	}
</div>

<style>
	.card-grid {
		width: 100%;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
		gap: var(--space-5);
	}

	.info-card {
		position: relative;
		min-height: 0;
		padding: var(--space-5) 0;
		border-block-start: 1px solid var(--color-border);
		text-align: start;
	}

	.info-card__index {
		display: inline-grid;
		width: 2.25rem;
		height: 2.25rem;
		margin-block-end: var(--space-3);
		place-items: center;
		border-radius: 999px;
		background: var(--color-secondary);
		color: var(--color-text-inverse);
		font-weight: 900;
	}

	.info-card h3 {
		margin: 0 0 var(--space-3);
		color: var(--color-ink);
		font-size: 1.2rem;
		line-height: 1.24;
	}

	.info-card p {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 1.02rem;
	}
</style>
