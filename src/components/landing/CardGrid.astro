---
interface Item {
	title: string;
	body: string;
}

interface Props {
	items: Item[];
	ordered?: boolean;
}

const { items, ordered = false } = Astro.props;
---

<div class="card-grid">
	{
		items.map((item, index) => (
			<article class="info-card">
				{ordered && <span class="info-card__index">{index + 1}</span>}
				<h3>{item.title}</h3>
				<p>{item.body}</p>
			</article>
		))
	}
</div>

<style>
	.card-grid {
		width: 100%;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-3);
	}

	.info-card {
		position: relative;
		min-height: 0;
		padding: 0.875rem;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		background: white;
		box-shadow: var(--shadow-soft);
		text-align: start;
	}

	.info-card__index {
		display: inline-grid;
		width: 2rem;
		height: 2rem;
		flex: 0 0 auto;
		place-items: center;
		border-radius: 999px;
		background: #dce1ff;
		color: var(--color-ink);
		font-weight: 900;
	}

	.info-card h3 {
		margin: 0 0 var(--space-3);
		color: var(--color-ink);
		font-size: 0.875rem;
		line-height: 1.24;
	}

	.info-card p {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		line-height: 1.55;
	}
</style>
