---
// Co-authored-by: Codex <codex@openai.com>
import Section from "./Section.astro";
import { mediaImageUrl } from "../../lib/landing/media-images";

interface Testimonial {
	quote: string;
	attribution?: string;
	authorImage?: { src: string; alt: string };
}

interface Props {
	title: string;
	testimonials: Testimonial[];
}

const { title, testimonials } = Astro.props;
---

<Section title={title} surface="stone">
	<div class="chat-thread" role="list" aria-label="עדויות של לומדים">
		{testimonials.map((testimonial) => {
			const author = testimonial.attribution;
			return (
			<article class="chat-message" role="listitem">
				<svg class="chat-message__tail" width="10" height="16" viewBox="0 0 8 13" preserveAspectRatio="none" aria-hidden="true" focusable="false">
					<path fill="#fff" transform="translate(8 0) scale(-1 1)" d="M1.533 2.568 8 11.193V0H2.812C1.042 0 .474 1.156 1.533 2.568Z" />
				</svg>
				<div class="chat-message__bubble">
					{(author || testimonial.authorImage) && <div class="chat-message__sender">
						{testimonial.authorImage && <img class="chat-message__profile" src={mediaImageUrl(testimonial.authorImage.src, 80, !import.meta.env.DEV)} alt={testimonial.authorImage.alt} width="40" height="40" loading="lazy" decoding="async" style="width: 2.5rem; height: 2.5rem; object-fit: cover; border-radius: 50%;" />}
						{author && <cite class="chat-message__author">{author}</cite>}
					</div>}
					<p>{testimonial.quote}</p>
				</div>
			</article>
			);
		})}
	</div>
</Section>

<style>
	@layer landing-components {
	.chat-thread {
		display: grid;
		gap: 0.75rem;
		width: 100%;
		padding: clamp(0.75rem, 2vw, 1.25rem);
		border: 1px solid #e4e0d8;
		border-radius: 18px;
		background-color: #eeeae2;
		background-image: radial-gradient(#d8d2c8 0.65px, transparent 0.65px);
		background-size: 13px 13px;
	}

	.chat-message {
		position: relative;
		justify-self: start;
		width: min(100%, 44rem);
		text-align: start;
	}

	.chat-message__tail {
		position: absolute;
		inset-block-start: 0;
		inset-inline-start: -0.5625rem;
		z-index: 0;
		width: 10px;
		height: 16px;
		overflow: visible;
		fill: #fff;
	}

	.chat-message__bubble {
		position: relative;
		z-index: 1;
		padding: 0.9rem 1rem 0.65rem;
		border-radius: 16px 0 16px 16px;
		background: #fff;
	}

	.chat-message__bubble > p {
		margin: 0;
		color: #202a32;
		font-size: 0.9rem;
		line-height: 1.65;
		white-space: pre-wrap;
	}

	.chat-message__author {
		color: var(--color-ink);
		display: block;
		font-size: 0.76rem;
		font-style: normal;
		font-weight: 700;
		line-height: 1.35;
	}

	.chat-message__sender {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-block-end: 0.4rem;
	}

	.chat-message__profile {
		width: 2.5rem;
		height: 2.5rem;
		flex: 0 0 2.5rem;
		border-radius: 50%;
		object-fit: cover;
	}

	@media (min-width: 1024px) {
		.chat-thread {
			max-width: 1120px;
			margin-inline: auto;
			gap: 1.25rem;
		}
		.chat-message { width: min(72%, 44rem); }
		.chat-message:nth-child(even) { justify-self: end; }
		.chat-message:nth-child(even) .chat-message__tail {
			inset-inline-start: auto;
			inset-inline-end: -0.5625rem;
			transform: scaleX(-1);
		}
		.chat-message:nth-child(even) .chat-message__bubble {
			border-radius: 0 16px 16px 16px;
		}
	}

	}
</style>
