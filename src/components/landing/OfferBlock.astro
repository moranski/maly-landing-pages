---
interface Props {
	title: string;
	body: string;
	includes: string[];
	lead: {
		endpoint: string;
		checkoutUrl: string;
		submitLabel: string;
		consentLabel: string;
	};
}

const { title, body, includes, lead } = Astro.props;
---

<section id="offer" class="offer">
	<div class="offer__inner">
		<div>
			<p class="kicker">ההצטרפות כוללת</p>
			<h2>{title}</h2>
			<p>{body}</p>
			<ul class="check-list">
				{includes.map((item) => <li>{item}</li>)}
			</ul>
		</div>
		<aside class="lead-box" aria-label="הצטרפות למסלול">
			<p class="lead-box__title">נשאיר פרטים ונעבור לתשלום מאובטח</p>
			<form class="lead-form" data-lead-endpoint={lead.endpoint} data-checkout-url={lead.checkoutUrl}>
				<label>
					<span>שם מלא</span>
					<input name="name" autocomplete="name" required />
				</label>
				<label>
					<span>כתובת אימייל</span>
					<input name="email" type="email" autocomplete="email" inputmode="email" required />
				</label>
				<label class="lead-form__consent">
					<input name="consent" type="checkbox" required />
					<span>{lead.consentLabel}</span>
				</label>
				<p class="lead-form__status" aria-live="polite"></p>
				<button class="button button--primary" type="submit">{lead.submitLabel}</button>
			</form>
		</aside>
	</div>
</section>

<script>
	const endpointPlaceholder = "REPLACE_WITH_EMAIL_LIST_ENDPOINT";

	document.querySelectorAll<HTMLFormElement>(".lead-form").forEach((form) => {
		form.addEventListener("submit", async (event) => {
			event.preventDefault();

			const endpoint = form.dataset.leadEndpoint;
			const checkoutUrl = form.dataset.checkoutUrl;
			const status = form.querySelector<HTMLElement>(".lead-form__status");
			const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');

			if (!checkoutUrl) return;

			if (endpoint && endpoint !== endpointPlaceholder) {
				try {
					if (submit) submit.disabled = true;
					if (status) status.textContent = "שומרים את הפרטים שלך…";

					const response = await fetch(endpoint, {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify(Object.fromEntries(new FormData(form))),
					});

					if (!response.ok) throw new Error("Lead capture failed");
				} catch {
					if (status) status.textContent = "לא הצלחנו לשמור את הפרטים. אפשר לנסות שוב.";
					if (submit) submit.disabled = false;
					return;
				}
			}

			window.location.assign(checkoutUrl);
		});
	});
</script>

<style>
	.offer {
		width: 100%;
		padding: 0;
		background: transparent;
	}

	.offer__inner {
		width: min(100%, var(--layout-width));
		margin-inline: auto;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
		align-items: start;
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: linear-gradient(180deg, color-mix(in srgb, var(--color-ink) 5%, white), white 55%);
		box-shadow: var(--shadow-soft);
	}

	.offer h2 {
		margin: 0 0 var(--space-5);
		color: var(--color-ink);
		font-size: 1.5rem;
		line-height: 1.3;
	}

	.offer p {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.check-list {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-3);
		margin: var(--space-6) 0 0;
		padding: 0;
		list-style: none;
	}

	.check-list li {
		position: relative;
		padding: var(--space-3) var(--space-7) var(--space-3) var(--space-4);
		border: 1px solid #bbf7d0;
		border-radius: 12px;
		background: #f0fdf4;
		color: var(--color-text);
		font-weight: 600;
	}

	.check-list li::before {
		content: "";
		position: absolute;
		inset-inline-start: var(--space-4);
		inset-block-start: 1.25rem;
		width: 1.05rem;
		height: 1.05rem;
		border-radius: 999px;
		background: var(--color-success);
	}

	.lead-box {
		position: sticky;
		top: var(--space-4);
		display: grid;
		gap: var(--space-4);
		padding: var(--space-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface);
		color: var(--color-ink);
		box-shadow: var(--shadow-lift);
		text-align: center;
	}

	.lead-box__title {
		margin: 0;
		color: var(--color-ink);
		font-size: 1rem;
		font-weight: 900;
	}

	.lead-form {
		display: grid;
		gap: var(--space-4);
		text-align: start;
	}

	.lead-form label:not(.lead-form__consent) {
		display: grid;
		gap: var(--space-2);
		color: var(--color-ink);
		font-weight: 800;
	}

	.lead-form input:not([type="checkbox"]) {
		width: 100%;
		min-height: 3.2rem;
		border: 2px solid var(--color-border);
		border-radius: 14px;
		background: white;
		padding: 0.7rem 0.85rem;
		color: var(--color-ink);
	}

	.lead-form input:focus-visible {
		outline: 3px solid var(--color-accent-soft);
		outline-offset: 3px;
	}

	.lead-form__consent {
		display: flex;
		align-items: flex-start;
		gap: var(--space-2);
		color: var(--color-text-muted);
		font-size: 0.75rem;
		line-height: 1.4;
	}

	.lead-form__consent input {
		margin-block-start: 0.2rem;
		accent-color: var(--color-success);
	}

	.lead-form__status {
		min-height: 1.5em;
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
	}

	.lead-form .button {
		width: 100%;
	}

	.lead-form .button:disabled {
		cursor: wait;
		opacity: 0.72;
	}

	@media (max-width: 900px) {
		.offer__inner {
			grid-template-columns: 1fr;
		}

		.lead-box {
			position: static;
		}
	}
</style>
