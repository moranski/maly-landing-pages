---
interface Props {
	title: string;
	body: string;
	includes: string[];
	demo?: boolean;
	kicker?: string;
}

const { title, body, includes, demo = false, kicker = "ההצטרפות כוללת" } = Astro.props;
---

<section id="offer" class="offer">
	<div class="offer__inner">
		<div>
			<p class="kicker">{kicker}</p>
			<h2>{title}</h2>
			<p>{body}</p>
			<ul class="check-list">
				{includes.map((item) => <li>{item}</li>)}
			</ul>
		</div>
		<aside class="lead-box" aria-label="הצטרפות למסלול">
			<div class="lead-form-embed">
				{demo ? (
					<fieldset class="demo-form" disabled>
						<legend>טופס לדוגמה בלבד — השליחה מושבתת</legend>
						<label>שם לדוגמה<input type="text" placeholder="ישראל ישראלי" /></label>
						<label>דוא״ל לדוגמה<input type="email" placeholder="example@example.com" dir="ltr" /></label>
						<button type="button" class="button button--primary" disabled>שליחה מושבתת בהדגמה</button>
					</fieldset>
				) : (
					<iframe class="signup-frame" data-signup-frame title="טופס הצטרפות למסלול" height="420"></iframe>
					<noscript><p>כדי להציג את טופס ההצטרפות, יש להפעיל JavaScript בדפדפן.</p></noscript>
				)}
			</div>
		</aside>
	</div>
</section>

<style>
	.offer {
		width: 100%;
		padding: 0;
		background: transparent;
	}

	.offer__inner {
		width: min(100%, var(--layout-width));
		margin-inline: auto;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
		align-items: start;
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: linear-gradient(180deg, color-mix(in srgb, var(--color-ink) 5%, white), white 55%);
		box-shadow: var(--shadow-soft);
	}

	.offer h2 {
		margin: 0 0 var(--space-5);
		color: var(--color-ink);
		font-size: 1.5rem;
		line-height: 1.3;
	}

	.offer p {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.check-list {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-3);
		margin: var(--space-6) 0 0;
		padding: 0;
		list-style: none;
	}

	.check-list li {
		position: relative;
		padding: var(--space-3) var(--space-7) var(--space-3) var(--space-4);
		border: 1px solid #bbf7d0;
		border-radius: 12px;
		background: #f0fdf4;
		color: var(--color-text);
		font-weight: 600;
	}

	.check-list li::before {
		content: "";
		position: absolute;
		inset-inline-start: var(--space-4);
		inset-block-start: 1.25rem;
		width: 1.05rem;
		height: 1.05rem;
		border-radius: 999px;
		background: var(--color-success);
	}

	.lead-box {
		position: sticky;
		top: var(--space-4);
		display: grid;
		gap: var(--space-4);
		padding: var(--space-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface);
		color: var(--color-ink);
		box-shadow: var(--shadow-lift);
		text-align: center;
	}

	.lead-box__title {
		margin: 0;
		color: var(--color-ink);
		font-size: 1rem;
		font-weight: 900;
	}

	.lead-form-embed {
		min-width: 0;
		text-align: start;
	}

	.demo-form { margin: 0; padding: 0; border: 0; display: grid; gap: var(--space-4); min-width: 0; }
	.demo-form legend { padding: 0; margin-block-end: var(--space-4); font-size: 0.875rem; }
	.demo-form label { display: grid; gap: var(--space-2); font-size: 0.875rem; }
	.demo-form input { width: 100%; min-width: 0; padding: var(--space-3); border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface-warm); color: var(--color-text-muted); }
	.demo-form button { cursor: not-allowed; opacity: 0.65; }
	.demo-form button:hover { transform: none; background: var(--color-accent); }

	@media (max-width: 900px) {
		.offer__inner {
			grid-template-columns: 1fr;
		}

		.lead-box {
			position: static;
		}
	}
</style>

<script>
 const frames = document.querySelectorAll<HTMLIFrameElement>('[data-signup-frame]');
 const load = (frame: HTMLIFrameElement) => {
  if (frame.hasAttribute('src')) return;
  frame.src = `/signup-embed${window.location.search}`;
 };
 window.addEventListener('message', (event) => {
  if (event.origin !== window.location.origin || event.data?.type !== 'signup-embed-height') return;
  const height = event.data.height;
  if (!Number.isFinite(height) || height < 1 || height > 20000) return;
  frames.forEach(frame => { if (event.source === frame.contentWindow) frame.height = String(height); });
 });
 if ('IntersectionObserver' in window) {
  const observer = new IntersectionObserver(entries => {
   entries.forEach(entry => { if (entry.isIntersecting) { load(entry.target as HTMLIFrameElement); observer.unobserve(entry.target); } });
  }, {rootMargin: '600px 0px'});
  frames.forEach(frame => observer.observe(frame));
 } else frames.forEach(load);
</script>
<style>
 .signup-frame { width: 100%; border: 0; display: block; min-width: 0; }
</style>
