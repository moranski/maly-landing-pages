---
interface Props {
	title: string;
	body: string;
	includes: string[];
	submitLabel: string;
	consentLabel?: string;
	checkoutUrl?: string;
	demo?: boolean;
	kicker?: string;
}

const {
	title,
	body,
	includes,
	submitLabel,
	consentLabel = "אני מאשר/ת קבלת עדכונים והצעות ממלי באימייל.",
	checkoutUrl = "",
	demo = false,
	kicker = "ההצטרפות כוללת",
} = Astro.props;

let safeCheckoutUrl = "";
try {
	const parsedCheckoutUrl = new URL(checkoutUrl);
	if (parsedCheckoutUrl.protocol === "https:") safeCheckoutUrl = parsedCheckoutUrl.href;
} catch {
	// Keep the CTA unavailable when the configured destination is missing or invalid.
}
---

<section id="offer" class="offer">
	<div class="offer__inner">
		<div>
			<p class="kicker">{kicker}</p>
			<h2>{title}</h2>
			<p>{body}</p>
			<ul class="check-list">
				{includes.map((item) => <li>{item}</li>)}
			</ul>
		</div>
		<aside class="lead-box" aria-label="הצטרפות למסלול">
			<div class="lead-form-embed">
				{safeCheckoutUrl ? (
					<a class="button button--primary" href={safeCheckoutUrl}>{submitLabel}</a>
				) : (
					<p class="offer__missing-url" role="status">{demo ? "קישור ההצטרפות יוצג כאן לאחר שיוגדר." : "קישור ההצטרפות אינו זמין כרגע."}</p>
				)}
			</div>
		</aside>
	</div>
</section>

<style>
	.offer {
		width: 100%;
		padding: 0;
		background: transparent;
	}

	.offer__inner {
		width: min(100%, var(--layout-width));
		margin-inline: auto;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
		align-items: start;
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: linear-gradient(180deg, color-mix(in srgb, var(--color-ink) 5%, white), white 55%);
		box-shadow: var(--shadow-soft);
	}

	.offer h2 {
		margin: 0 0 var(--space-5);
		color: var(--color-ink);
		font-size: 1.5rem;
		line-height: 1.3;
	}

	.offer p {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.check-list {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-3);
		margin: var(--space-6) 0 0;
		padding: 0;
		list-style: none;
	}

	.check-list li {
		position: relative;
		padding: var(--space-3) var(--space-7) var(--space-3) var(--space-4);
		border: 1px solid #bbf7d0;
		border-radius: 12px;
		background: #f0fdf4;
		color: var(--color-text);
		font-weight: 600;
	}

	.check-list li::before {
		content: "";
		position: absolute;
		inset-inline-start: var(--space-4);
		inset-block-start: 1.25rem;
		width: 1.05rem;
		height: 1.05rem;
		border-radius: 999px;
		background: var(--color-success);
	}

	.lead-box {
		position: sticky;
		top: var(--space-4);
		display: grid;
		gap: var(--space-4);
		padding: var(--space-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface);
		color: var(--color-ink);
		box-shadow: var(--shadow-lift);
		text-align: center;
	}

	.lead-box__title {
		margin: 0;
		color: var(--color-ink);
		font-size: 1rem;
		font-weight: 900;
	}

	.lead-form-embed {
		min-width: 0;
		text-align: start;
	}

	.offer__missing-url { margin: 0; text-align: center; }
	.lead-form-embed .button {
		width: 100%;
		background: #087f5b;
		box-shadow: 0 8px 20px rgb(8 127 91 / 24%);
	}
	.lead-form-embed .button:hover { background: #066b4c; }

	@media (max-width: 900px) {
		.offer__inner {
			grid-template-columns: 1fr;
		}

		.lead-box {
			position: static;
		}
	}
</style>
