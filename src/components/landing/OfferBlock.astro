---
interface Props {
	title: string;
	body: string;
	includes: string[];
	lead: {
		endpoint: string;
		checkoutUrl: string;
		submitLabel: string;
		consentLabel: string;
	};
}

const { title, body, includes, lead } = Astro.props;
---

<section id="offer" class="offer">
	<div class="offer__inner">
		<div>
			<p class="kicker">ההצטרפות כוללת</p>
			<h2>{title}</h2>
			<p>{body}</p>
			<ul class="check-list">
				{includes.map((item) => <li>{item}</li>)}
			</ul>
		</div>
		<aside class="lead-box" aria-label="הצטרפות למסלול">
			<p class="lead-box__title">נשאיר פרטים ונעבור לתשלום מאובטח</p>
			<form class="lead-form" data-lead-endpoint={lead.endpoint} data-checkout-url={lead.checkoutUrl}>
				<label>
					<span>שם מלא</span>
					<input name="name" autocomplete="name" required />
				</label>
				<label>
					<span>כתובת אימייל</span>
					<input name="email" type="email" autocomplete="email" inputmode="email" required />
				</label>
				<label class="lead-form__consent">
					<input name="consent" type="checkbox" required />
					<span>{lead.consentLabel}</span>
				</label>
				<p class="lead-form__status" aria-live="polite"></p>
				<button class="button button--primary" type="submit">{lead.submitLabel}</button>
			</form>
		</aside>
	</div>
</section>

<script>
	const endpointPlaceholder = "REPLACE_WITH_EMAIL_LIST_ENDPOINT";

	document.querySelectorAll<HTMLFormElement>(".lead-form").forEach((form) => {
		form.addEventListener("submit", async (event) => {
			event.preventDefault();

			const endpoint = form.dataset.leadEndpoint;
			const checkoutUrl = form.dataset.checkoutUrl;
			const status = form.querySelector<HTMLElement>(".lead-form__status");
			const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');

			if (!checkoutUrl) return;

			if (endpoint && endpoint !== endpointPlaceholder) {
				try {
					if (submit) submit.disabled = true;
					if (status) status.textContent = "שומרים את הפרטים שלך…";

					const response = await fetch(endpoint, {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify(Object.fromEntries(new FormData(form))),
					});

					if (!response.ok) throw new Error("Lead capture failed");
				} catch {
					if (status) status.textContent = "לא הצלחנו לשמור את הפרטים. אפשר לנסות שוב.";
					if (submit) submit.disabled = false;
					return;
				}
			}

			window.location.assign(checkoutUrl);
		});
	});
</script>

<style>
	.offer {
		padding: var(--space-section) var(--space-page);
		background:
			radial-gradient(circle at 15% 12%, rgba(255, 215, 63, 0.35), transparent 18rem),
			radial-gradient(circle at 82% 78%, rgba(255, 63, 143, 0.22), transparent 20rem),
			linear-gradient(135deg, #2b1d67, #167fa5);
	}

	.offer__inner {
		width: min(100%, var(--layout-width));
		margin-inline: auto;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(300px, 0.4fr);
		gap: var(--space-8);
		align-items: start;
		padding: clamp(1rem, 3vw, 2rem);
		border: 5px solid rgba(255, 255, 255, 0.36);
		border-radius: 34px;
		background: rgba(255, 255, 255, 0.12);
		box-shadow: var(--shadow-lift);
		backdrop-filter: blur(8px);
	}

	.offer h2 {
		margin: 0 0 var(--space-5);
		color: var(--color-text-inverse);
		font-size: clamp(2rem, 1.7rem + 1.4vw, 3.1rem);
		line-height: 1.12;
	}

	.offer p {
		margin: 0;
		color: rgba(255, 255, 255, 0.86);
		font-size: 1.15rem;
	}

	.check-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: var(--space-3);
		margin: var(--space-6) 0 0;
		padding: 0;
		list-style: none;
	}

	.check-list li {
		position: relative;
		padding: var(--space-4) var(--space-7) var(--space-4) var(--space-4);
		border: 3px solid rgba(255, 255, 255, 0.78);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.92);
		box-shadow: var(--shadow-soft);
		color: var(--color-ink);
		font-weight: 800;
	}

	.check-list li::before {
		content: "";
		position: absolute;
		inset-inline-start: var(--space-4);
		inset-block-start: 1.25rem;
		width: 1.05rem;
		height: 1.05rem;
		border-radius: 999px;
		background: var(--color-success);
	}

	.lead-box {
		position: sticky;
		top: var(--space-4);
		display: grid;
		gap: var(--space-4);
		padding: var(--space-6);
		border: 5px solid white;
		border-radius: 30px;
		background: linear-gradient(180deg, #fff, #ffe7a8);
		color: var(--color-ink);
		box-shadow: var(--shadow-lift);
		text-align: center;
	}

	.lead-box__title {
		margin: 0;
		color: var(--color-accent-strong);
		font-size: 1.28rem;
		font-weight: 900;
	}

	.lead-form {
		display: grid;
		gap: var(--space-4);
		text-align: start;
	}

	.lead-form label:not(.lead-form__consent) {
		display: grid;
		gap: var(--space-2);
		color: var(--color-ink);
		font-weight: 800;
	}

	.lead-form input:not([type="checkbox"]) {
		width: 100%;
		min-height: 3.2rem;
		border: 2px solid var(--color-border);
		border-radius: 14px;
		background: white;
		padding: 0.7rem 0.85rem;
		color: var(--color-ink);
	}

	.lead-form input:focus-visible {
		outline: 3px solid var(--color-secondary);
		outline-offset: 2px;
	}

	.lead-form__consent {
		display: flex;
		align-items: flex-start;
		gap: var(--space-2);
		color: var(--color-text-muted);
		font-size: 0.9rem;
		line-height: 1.4;
	}

	.lead-form__consent input {
		margin-block-start: 0.2rem;
		accent-color: var(--color-accent);
	}

	.lead-form__status {
		min-height: 1.5em;
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	.lead-form .button {
		width: 100%;
	}

	.lead-form .button:disabled {
		cursor: wait;
		opacity: 0.72;
	}

	@media (max-width: 900px) {
		.offer__inner {
			grid-template-columns: 1fr;
		}

		.lead-box {
			position: static;
		}
	}
</style>
