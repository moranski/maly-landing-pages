---
// Co-authored-by: Codex <codex@openai.com>
import CardGrid from "./CardGrid.astro";
import FinalCta from "./FinalCta.astro";
import ImageGallery from "./ImageGallery.astro";
import LandingPageLayout from "../../layouts/LandingPage.astro";
import LandingPageContent from "./LandingPageContent.astro";
import OfferBlock from "./OfferBlock.astro";
import ProfileImage from "./ProfileImage.astro";
import Section from "./Section.astro";
import FaqList from "./FaqList.astro";
import RichTextContent from "./RichTextContent.astro";
import TestimonialsBlock from "./TestimonialsBlock.astro";
import type { EditProxy } from "emdash";
import { normalizeLandingPage } from "../../lib/landing/normalize";

interface Props { page: unknown; preview?: boolean; contentId?: string; edit?: EditProxy; }
const { page: rawPage, contentId, edit, preview = false } = Astro.props;
const { page, diagnostics } = normalizeLandingPage(rawPage);
if (diagnostics.length) console.warn("Landing page validation", diagnostics);
if (!page) {
  Astro.response.status = 500;
  return new Response(null, { status: 500 });
}
---
<LandingPageLayout page={page} preview={preview} contentId={contentId} edit={edit}>
  <LandingPageContent page={page} layoutEdit={edit?.layout}>
    {page.blocks.map(block => {
      if (block.kind === "section") return <Section surface={block.surface} id={block.id} kicker={block.kicker} title={block.title} mediaLayout={block.profile ? "image-right" : block.mediaLayout} profileLayout={Boolean(block.profile)}>
        <RichTextContent body={block.body} listStyle={block.listStyle} />
        {block.cards.length > 0 && <CardGrid ordered={block.orderedCards} items={block.cards} />}
        {block.profile && <ProfileImage slot="media" {...block.profile} variant="editorial" />}
        {block.gallery.length > 0 && <ImageGallery slot="media" images={block.gallery} preserveAspect={block.mediaLayout !== "stacked"} />}
        {block.faq.length > 0 && <FaqList items={block.faq} />}
      </Section>;
      if (block.kind === "testimonials") return <TestimonialsBlock title={block.title} testimonials={block.items} />;
      if (block.kind === "offer") return <OfferBlock title={block.title} body={block.body} includes={block.includes} kicker={block.kicker} cta={block.cta} />;
      if (block.kind === "final") return <FinalCta kicker={block.kicker} cta={block.cta} image={block.image}><h2>{block.heading}</h2><RichTextContent body={block.body} />{block.signature && <strong>{block.signature}</strong>}</FinalCta>;
    })}
  </LandingPageContent>
</LandingPageLayout>
