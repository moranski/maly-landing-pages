---
// Co-authored-by: Codex <codex@openai.com>
import Kicker from "./Kicker.astro";
import type { SectionMediaLayout } from "../../lib/landing/normalize";
interface Props {
	kicker?: string;
	title: string;
	id?: string;
	surface?: "ivory" | "stone" | "peach" | "sage" | "butter" | "blue" | "lilac" | "navy";
	mediaLayout?: SectionMediaLayout;
	profileLayout?: boolean;
}

const { kicker, title, id, surface = "ivory", mediaLayout = "stacked", profileLayout = false } = Astro.props;
const hasMedia = Astro.slots.has("media");
---

<section id={id} class:list={["section", `surface--${surface}`]} data-media-layout={hasMedia ? mediaLayout : undefined} data-profile-layout={profileLayout ? "editorial" : undefined}>
	<div class="section__inner">
		<div class="section__text">
			<div class="section__header">
				{kicker && <Kicker variant="soft">{kicker}</Kicker>}
				<h2>{title}</h2>
			</div>
			<div class="section__content section-prose">
				<slot />
			</div>
		</div>
		{hasMedia && <div class="section__media"><slot name="media" /></div>}
	</div>
</section>

<style>
	@layer landing-components {
	.section {
		position: relative;
		width: 100%;
		padding: 0;
		background: transparent;
	}

	.surface--ivory { --section-surface: var(--surface-ivory); }
	.surface--stone { --section-surface: var(--surface-stone); }
	.surface--peach { --section-surface: var(--surface-peach); }
	.surface--sage { --section-surface: var(--surface-sage); }
	.surface--butter { --section-surface: var(--surface-butter); }
	.surface--blue { --section-surface: var(--surface-blue); }
	.surface--lilac { --section-surface: var(--surface-lilac); }
	.surface--navy { --section-surface: var(--surface-navy); }

	.section {
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--section-surface);
	}

	.section__inner {
		width: 100%;
		margin-inline: auto;
		display: grid;
		gap: var(--space-4);
	}
	.section__text, .section__media { min-width: 0; }
		.section[data-profile-layout="editorial"] .section__media { order: -1; }

	.section__header {
		max-width: 100%;
		margin-inline: auto;
		margin-block-end: var(--space-4);
		text-align: center;
	}

	.section__header h2 {
		margin: 0;
		font-size: clamp(1.5rem, 1.3rem + 1vw, 2rem);
		line-height: 1.3;
	}

	.section__header > .kicker {
		margin: 0;
	}

	.section__content {
		display: grid;
		gap: var(--space-3);
		justify-items: stretch;
	}

	.section-prose :global(p) {
		max-width: 100%;
		margin: 0;
		color: var(--color-text);
		font-size: 0.875rem;
		line-height: 1.6;
		text-align: start;
	}

	.section-prose :global(p + p) {
		margin-block-start: 0;
	}

	.section-prose :global(blockquote) {
		max-width: 100%;
		margin: 0;
		padding: var(--space-4);
		border: 0;
		border-radius: var(--radius-card);
		background: white;
		color: var(--color-ink);
		font-size: 0.95rem;
		font-weight: 800;
		text-align: center;
		box-shadow: var(--shadow-soft);
	}

	.section-prose :global(blockquote)::before {
		content: "״";
		display: block;
		margin-block-end: var(--space-2);
		color: var(--color-accent);
		font-size: 3rem;
		line-height: 0.7;
	}

	.section-prose :global(blockquote p) {
		margin: 0;
		color: inherit;
		font-size: inherit;
	}

	.section-prose :global(h3) {
		max-width: 100%;
		width: 100%;
		margin: 0 0 calc(-1 * var(--space-4));
		padding: var(--space-3) var(--space-4);
		border-radius: 12px;
		background: white;
		color: var(--color-ink);
		font-size: 0.875rem;
		line-height: 1.25;
		text-align: center;
		box-shadow: var(--shadow-soft);
	}

	.section-prose :global(.info-card h3) {
		width: auto;
		margin: 0 0 var(--space-2);
		padding: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		text-align: start;
	}

	.section-prose :global(.info-card p) {
		color: var(--color-text-muted);
		font-size: 0.75rem;
		text-align: start;
	}
	}
</style>
