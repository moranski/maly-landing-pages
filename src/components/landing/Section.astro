---
interface Props {
	kicker?: string;
	title: string;
	tone?: "plain" | "tinted" | "deep";
	id?: string;
}

const { kicker, title, tone = "plain", id } = Astro.props;
---

<section id={id} class:list={["section", `section--${tone}`]}>
	<div class="section__inner">
		<div class="section__header">
			{kicker && <p class="kicker">{kicker}</p>}
			<h2>{title}</h2>
		</div>
		<div class="section__content section-prose">
			<slot />
		</div>
	</div>
</section>

<style>
	.section {
		position: relative;
		width: 100%;
		padding: 0;
		background: transparent;
	}

	.section--tinted {
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: #f5f3ef;
	}

	.section--deep {
		padding: 1.25rem;
		border-radius: var(--radius-card);
		background: var(--color-ink);
		color: var(--color-text-inverse);
	}

	.section__inner {
		width: 100%;
		margin-inline: auto;
	}

	.section__header {
		max-width: 100%;
		margin-inline: auto;
		margin-block-end: var(--space-4);
		text-align: center;
	}

	.section__header h2 {
		margin: 0;
		font-size: clamp(1.5rem, 1.3rem + 1vw, 2rem);
		line-height: 1.3;
	}

	.section__header > .kicker {
		margin: 0;
		padding: 0;
		background: transparent;
		color: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 700;
	}

	.section--deep h2 {
		color: var(--color-text-inverse);
	}

	.section--deep .section__header > .kicker {
		background: color-mix(in srgb, white 12%, transparent);
		color: #ffdbce;
	}

	.section__content {
		display: grid;
		gap: var(--space-3);
		justify-items: stretch;
	}

	.section-prose :global(p) {
		max-width: 100%;
		margin: 0;
		color: var(--color-text);
		font-size: 0.875rem;
		line-height: 1.6;
		text-align: start;
	}

	.section--deep .section-prose > :global(p) {
		color: color-mix(in srgb, white 88%, transparent);
	}

	.section-prose :global(p + p) {
		margin-block-start: 0;
	}

	.section-prose :global(blockquote) {
		max-width: 100%;
		margin: 0;
		padding: var(--space-4);
		border: 0;
		border-radius: var(--radius-card);
		background: white;
		color: var(--color-ink);
		font-size: 0.95rem;
		font-weight: 800;
		text-align: center;
		box-shadow: var(--shadow-soft);
	}

	.section-prose :global(blockquote)::before {
		content: "״";
		display: block;
		margin-block-end: var(--space-2);
		color: var(--color-accent);
		font-size: 3rem;
		line-height: 0.7;
	}

	.section-prose :global(blockquote p) {
		margin: 0;
		color: inherit;
		font-size: inherit;
	}

	.section-prose :global(h3) {
		max-width: 100%;
		width: 100%;
		margin: 0 0 calc(-1 * var(--space-4));
		padding: var(--space-3) var(--space-4);
		border-radius: 12px;
		background: white;
		color: var(--color-ink);
		font-size: 0.875rem;
		line-height: 1.25;
		text-align: center;
		box-shadow: var(--shadow-soft);
	}

	.section-prose :global(.info-card h3) {
		width: auto;
		margin: 0 0 var(--space-2);
		padding: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		text-align: start;
	}

	.section-prose :global(.info-card p) {
		color: var(--color-text-muted);
		font-size: 0.75rem;
		text-align: start;
	}

	.kicker {
		margin: 0 0 var(--space-3);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.25rem 0.65rem;
		border-radius: var(--radius-pill);
		background: white;
		color: var(--color-ink);
		font-size: var(--font-size-small);
		font-weight: 900;
		letter-spacing: 0;
		box-shadow: none;
	}

	.section--deep .kicker {
		color: var(--color-accent-soft);
	}
</style>
