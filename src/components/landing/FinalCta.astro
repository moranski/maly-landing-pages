---
// Co-authored-by: Codex <codex@openai.com>
import type { Cta } from "../../lib/landing/normalize";
interface Props {
	kicker?: string | null;
	cta?: Cta;
}

const { cta, kicker } = Astro.props;
---

<section id="contact" class="final-cta">
	<div class="final-cta__inner">
		{kicker && <p class="kicker">{kicker}</p>}
		<div class="final-cta__content">
			<slot />
		</div>
		{cta && <a class="button button--primary" data-cta-style={cta.style} href={cta.href}>{cta.label}</a>}
	</div>
</section>

<style>
	@layer landing-components {
	.final-cta {
		width: 100%;
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface-warm);
		color: var(--color-text);
		text-align: center;
	}

	.final-cta__inner {
		width: 100%;
		margin-inline: auto;
		padding: 0;
	}

	.final-cta :global(h2) {
		margin: 0 0 var(--space-5);
		color: var(--color-ink);
		font-size: 1.5rem;
		line-height: 1.3;
	}

	.final-cta :global(p) {
		margin: 0;
		color: var(--color-text-muted);
	}

	.final-cta :global(p + p) {
		margin-block-start: var(--space-4);
	}

	.final-cta :global(strong) {
		display: block;
		margin-block: var(--space-6);
		color: var(--color-success);
		font-size: 1.5rem;
	}

	.final-cta .button {
		margin-block-start: var(--space-4);
	}
	}
</style>
