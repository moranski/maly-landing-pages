---
// Co-authored-by: Codex <codex@openai.com>
import type { Cta, Image } from "../../lib/landing/normalize";
import { responsiveMediaImage } from "../../lib/landing/media-images";
interface Props {
	kicker?: string | null;
	cta?: Cta;
	image?: Image;
}

const { cta, kicker, image } = Astro.props;
---

<section id="contact" class="final-cta">
	<div class:list={["final-cta__inner", { "final-cta__inner--portrait": image }]}>
		{image && <figure class="final-cta__portrait">
			<img {...responsiveMediaImage(image.src, [224, 280, 448, 560], "(min-width: 1024px) 280px, (min-width: 356px) 280px, calc(100vw - 76px)", !import.meta.env.DEV, image.width)} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
		</figure>}
		<div class="final-cta__copy">
			{kicker && <p class="kicker">{kicker}</p>}
			<div class="final-cta__content"><slot /></div>
			{cta && <a class="button button--primary" data-cta-style={cta.style} href={cta.href}>{cta.label}</a>}
		</div>
	</div>
</section>

<style>
	@layer landing-components {
	.final-cta {
		width: 100%;
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-surface-warm);
		color: var(--color-text);
		text-align: center;
	}

	.final-cta__inner {
		width: 100%;
		margin-inline: auto;
		padding: 0;
	}

	.final-cta__inner--portrait { display: grid; gap: var(--space-5); align-items: center; }
	.final-cta__portrait { width: min(100%, 280px); margin: 0; justify-self: center; }
	.final-cta__portrait img { width: 100%; height: auto; border-radius: 20px; }
	@media (min-width: 1024px) {
		.final-cta__inner--portrait { grid-template-columns: minmax(0, 1fr) 280px; gap: var(--space-8); }
		.final-cta__inner--portrait .final-cta__copy { grid-column: 1; grid-row: 1; }
		.final-cta__portrait { grid-column: 2; grid-row: 1; }
	}

	.final-cta :global(h2) {
		margin: 0 0 var(--space-5);
		color: var(--color-ink);
		font-size: 1.5rem;
		line-height: 1.3;
	}

	.final-cta :global(p) {
		margin: 0;
		color: var(--color-text-muted);
	}

	.final-cta :global(p + p) {
		margin-block-start: var(--space-4);
	}

	.final-cta :global(strong) {
		display: block;
		margin-block: var(--space-6);
		color: var(--color-success);
		font-size: 1.5rem;
	}

	.final-cta .button {
		margin-block-start: var(--space-4);
	}
	}
</style>
