---
<div class="parallax-background" aria-hidden="true"></div>
<script is:inline>
 (() => {
 const layer = document.querySelector(".parallax-background");
 const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
 let frame = 0;
 let currentY = 0;
 const paint = () => {
  frame = 0;
  if (!layer) return;
  const targetY = motion.matches ? 0 : -(window.scrollY * 0.25 % 1086);
  // Ease toward the scroll position so the background has a little inertia.
  currentY = motion.matches ? targetY : currentY + (targetY - currentY) * 0.12;
  if (Math.abs(targetY - currentY) < 0.1) currentY = targetY;
  // Wrap at one tile height so long pages never expose the edge of the layer.
  layer.style.transform = `translate3d(0, ${currentY}px, 0)`;
  if (currentY !== targetY) frame = requestAnimationFrame(paint);
 };
 const schedule = () => {
  if (!frame) frame = requestAnimationFrame(paint);
 };
 window.addEventListener("scroll", schedule, { passive: true });
 motion.addEventListener("change", schedule);
 paint();
 })();
</script>
<style>
 .parallax-background {
  position: fixed; inset: -1086px 0; z-index: -1; pointer-events: none;
  background-image: var(--review-background-image);
  background-size: 362px 1086px; background-repeat: repeat;
  will-change: transform;
 }
 @media (prefers-reduced-motion: reduce) { .parallax-background { will-change: auto; } }
</style>
