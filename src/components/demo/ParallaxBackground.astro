---
<div class="parallax-background" aria-hidden="true"></div>
<script is:inline>
 (() => {
 const layer = document.querySelector(".parallax-background");
 const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
 let frame = 0;
 const paint = () => {
  frame = 0;
  if (!layer) return;
  const targetY = motion.matches ? 0 : -(window.scrollY * 0.25);
  // Move the repeating image within a viewport-sized layer so the offset can
  // stay continuous across long pages without exposing the layer's edges.
  layer.style.backgroundPositionY = `${targetY}px`;
 };
 const schedule = () => {
  if (!frame) frame = requestAnimationFrame(paint);
 };
 window.addEventListener("scroll", schedule, { passive: true });
 motion.addEventListener("change", schedule);
 paint();
 })();
</script>
<style>
 .parallax-background {
  position: fixed; inset: 0; z-index: -1; pointer-events: none;
  background-image: var(--landing-background-image, none);
  background-size: 362px 1086px; background-repeat: repeat;
  will-change: background-position;
 }
 @media (prefers-reduced-motion: reduce) { .parallax-background { will-change: auto; } }
</style>
