{
  "slug": "landing_offer",
  "label": "הצעה ותשלום",
  "version": 2,
  "fields": [
    {
      "slug": "title",
      "label": "כותרת",
      "type": "string",
      "required": true,
      "validation": {
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    {
      "slug": "body",
      "label": "תוכן",
      "type": "text",
      "required": true,
      "validation": {
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    {
      "slug": "includes",
      "label": "מה כלול",
      "type": "repeater",
      "required": true,
      "validation": {
        "subFields": [
          {
            "slug": "text",
            "type": "string",
            "label": "פריט",
            "required": true
          }
        ],
        "minItems": 1
      }
    },
    {
      "slug": "checkout_url",
      "label": "קישור לתשלום",
      "type": "url",
      "required": true,
      "validation": {
        "minLength": 1,
        "pattern": "^https://[^\\s]+$"
      }
    },
    {
      "slug": "submit_label",
      "label": "טקסט כפתור",
      "type": "string",
      "required": true,
      "validation": {
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    {
      "slug": "cta_style",
      "label": "סגנון כפתור",
      "type": "select",
      "defaultValue": "ברירת מחדל",
      "validation": {
        "options": [
          "ברירת מחדל",
          "כתום",
          "כתום אדום",
          "כחול כהה",
          "מסגרת כחולה",
          "לבן"
        ]
      }
    },
    {
      "slug": "kicker",
      "label": "כותרת קטנה",
      "type": "string"
    }
  ]
}
