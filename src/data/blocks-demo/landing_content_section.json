{
  "slug": "landing_content_section",
  "label": "מקטע תוכן",
  "version": 2,
  "fields": [
    {
      "slug": "id",
      "label": "מזהה מקטע",
      "type": "string"
    },
    {
      "slug": "kicker",
      "label": "כותרת קטנה",
      "type": "string"
    },
    {
      "slug": "title",
      "label": "כותרת",
      "type": "string",
      "required": true,
      "validation": {
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    {
      "slug": "background",
      "label": "סוג רקע",
      "type": "select",
      "required": true,
      "defaultValue": "שנהב",
      "validation": {
        "options": [
          "שנהב",
          "אבן",
          "אפרסק",
          "מרווה",
          "צהוב",
          "כחול",
          "סגול",
          "כחול כהה"
        ]
      }
    },
    {
      "slug": "paragraphs",
      "label": "פסקאות",
      "type": "repeater",
      "validation": {
        "subFields": [
          {
            "slug": "text",
            "type": "text",
            "label": "טקסט",
            "required": true
          }
        ]
      }
    },
    {
      "slug": "cards",
      "label": "כרטיסים",
      "type": "repeater",
      "validation": {
        "subFields": [
          {
            "slug": "title",
            "type": "string",
            "label": "כותרת",
            "required": true
          },
          {
            "slug": "body",
            "type": "text",
            "label": "תוכן",
            "required": true
          }
        ]
      }
    },
    {
      "slug": "ordered_cards",
      "label": "מספור כרטיסים",
      "type": "boolean",
      "defaultValue": false
    },
    {
      "slug": "profile_image",
      "label": "תמונת פרופיל",
      "type": "image",
      "validation": {
        "allowedMimeTypes": [
          "image/webp"
        ]
      }
    },
    {
      "slug": "profile_alt",
      "label": "טקסט חלופי לתמונת פרופיל",
      "type": "string"
    },
    {
      "slug": "profile_caption",
      "label": "כיתוב לתמונת פרופיל",
      "type": "string"
    },
    {
      "slug": "gallery",
      "label": "גלריה",
      "type": "repeater",
      "validation": {
        "subFields": [
          {
            "slug": "image",
            "type": "image",
            "label": "תמונה",
            "required": true
          },
          {
            "slug": "alt",
            "type": "string",
            "label": "טקסט חלופי",
            "required": true
          },
          {
            "slug": "caption",
            "type": "string",
            "label": "כיתוב"
          }
        ]
      }
    },
    {
      "slug": "faq_items",
      "label": "שאלות נפוצות",
      "type": "repeater",
      "validation": {
        "subFields": [
          {
            "slug": "question",
            "type": "string",
            "label": "שאלה",
            "required": true
          },
          {
            "slug": "answer",
            "type": "text",
            "label": "תשובה",
            "required": true
          }
        ]
      }
    },
    {
      "slug": "paragraph_format",
      "label": "תצוגת פסקאות",
      "type": "select",
      "required": true,
      "defaultValue": "paragraphs",
      "validation": {
        "options": [
          "paragraphs",
          "bullets",
          "checklist",
          "cross_list"
        ]
      }
    }
  ]
}
