---
import { getEmDashEntry } from "emdash";
import EmDashLandingPage from "../components/landing/EmDashLandingPage.astro";

export const prerender = false;

const slug = Astro.params.slug;
if (!slug) {
	Astro.response.status = 404;
}

const { entry: emdashPage, error } = slug
	? await getEmDashEntry("landing_pages", slug)
	: { entry: undefined, error: undefined };

if (error) {
	console.error(`Unable to load EmDash landing page "${slug}":`, error);
}

if (!emdashPage) {
	Astro.response.status = 404;
}

// Public page fields are deliberately allowlisted. Internal authoring context
// must never be forwarded to the page component or serialized into output.
const pageData = emdashPage
	? {
		title: emdashPage.data.title,
		description: emdashPage.data.description,
		lang: emdashPage.data.lang,
		dir: emdashPage.data.dir,
		layout: emdashPage.data.layout,
	}
	: undefined;
---

{
	emdashPage ? (
		<EmDashLandingPage page={pageData as never} />
	) : (
		<main><h1>העמוד לא נמצא</h1></main>
	)
}
