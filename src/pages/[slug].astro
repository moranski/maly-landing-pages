---
// Co-authored-by: Codex <codex@openai.com>
import { getEmDashEntry } from "emdash";
import { landingPagePath } from "../lib/landing/urls";
export const prerender = false;
const slug = Astro.params.slug;
const { entry, error, isPreview } = slug ? await getEmDashEntry("landing_pages", slug) : { entry: null, error: undefined, isPreview: false };
if (error) {
    console.error("Unable to resolve legacy landing URL", { slug, error });
    return new Response("לא ניתן לטעון את העמוד", { status: 500, headers: { "Content-Type": "text/plain; charset=utf-8" } });
}
if (!entry || !slug) return new Response("העמוד לא נמצא", { status: 404, headers: { "Content-Type": "text/plain; charset=utf-8" } });
// Keep campaign parameters and preview tokens; browsers retain the fragment.
return Astro.redirect(landingPagePath(slug) + Astro.url.search, isPreview ? 307 : 308);
---
