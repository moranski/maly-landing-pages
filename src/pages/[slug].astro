---
import { getEmDashEntry } from "emdash";
import EmDashLandingPage from "../components/landing/EmDashLandingPage.astro";

export const prerender = false;

const slug = Astro.params.slug;
if (!slug) {
	Astro.response.status = 404;
}

const { entry: emdashPage, error } = slug
	? await getEmDashEntry("landing_pages", slug)
	: { entry: undefined, error: undefined };

if (error) {
	console.error(`Unable to load EmDash landing page "${slug}":`, error);
}

if (!emdashPage) {
	Astro.response.status = 404;
}
---

{
	emdashPage ? (
		<EmDashLandingPage page={emdashPage.data as never} />
	) : (
		<main><h1>העמוד לא נמצא</h1></main>
	)
}
