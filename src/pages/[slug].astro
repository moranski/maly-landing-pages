---
import { getEmDashEntry } from "emdash";
import EmDashLandingPage from "../components/landing/EmDashLandingPage.astro";

export const prerender = false;

const slug = Astro.params.slug;
if (!slug) {
	Astro.response.status = 404;
}

const { entry: emdashPage, error } = slug
	? await getEmDashEntry("landing_pages", slug)
	: { entry: undefined, error: undefined };

if (error) {
	console.error(`Unable to load EmDash landing page "${slug}":`, error);
}

if (!emdashPage) {
	Astro.response.status = 404;
}

// Public display fields are deliberately allowlisted; private authoring context
// such as agent_context stays out of the rendered page. EmDash's edit proxy is
// passed separately and emits annotations only for authenticated edit sessions.
const pageData = emdashPage
	? {
		title: emdashPage.data.title,
		description: emdashPage.data.description,
		lang: emdashPage.data.lang,
		dir: emdashPage.data.dir,
		layout: emdashPage.data.layout,
	}
	: undefined;
---

{
	emdashPage ? (
		<EmDashLandingPage
			presentation={slug === "reading"}
			page={pageData as never}
			contentId={emdashPage.id}
			edit={emdashPage.edit}
		/>
	) : (
		<main><h1>העמוד לא נמצא</h1></main>
	)
}
