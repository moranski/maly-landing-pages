---
// Co-authored-by: Codex <codex@openai.com>
import { plainTextToRichText } from "../lib/landing/rich-text";
import LandingFonts from "../components/LandingFonts.astro";
import { landingBackgroundStyle } from "../lib/landing/media-images";
import ParallaxBackground from "../components/demo/ParallaxBackground.astro";
import "../styles/global.css";
import "../styles/presentation.css";
import Kicker from "../components/landing/Kicker.astro";
import RichTextContent from "../components/landing/RichTextContent.astro";
import RichTextEditorDemo from "../components/demo/RichTextEditorDemo";
import { normalizeRichText } from "../lib/landing/rich-text";
import { destination } from "../lib/landing/normalize";
import FaqList from "../components/landing/FaqList.astro";
import DemoFrame from "../components/demo/DemoFrame.astro";
import StickyMobileCta from "../components/landing/StickyMobileCta.astro";
import LandingHeader from "../components/landing/LandingHeader.astro";
import LandingPageContent from "../components/landing/LandingPageContent.astro";
import Section from "../components/landing/Section.astro";
import CardGrid from "../components/landing/CardGrid.astro";
import ProfileImage from "../components/landing/ProfileImage.astro";
import ImageGallery from "../components/landing/ImageGallery.astro";
import OfferBlock from "../components/landing/OfferBlock.astro";
import FinalCta from "../components/landing/FinalCta.astro";
import type { CtaStyle } from "../lib/landing/normalize";

const ctaPresets: { style: CtaStyle; label: string }[] = [
    { style: "orange", label: "כתום" },
    { style: "red-orange", label: "כתום אדום" },
    { style: "navy", label: "כחול כהה" },
    { style: "outline", label: "מסגרת כחולה" },
    { style: "white", label: "לבן" },
];

export const prerender = false;
if (!import.meta.env.DEV) {
	return new Response("העמוד לא נמצא", { status: 404, headers: { "Content-Type": "text/plain; charset=utf-8" } });
}

const examples = [
	{ id: "top", label: "פתיח" },
	{ id: "rich-text-standard", label: "טקסט עשיר" },
	{ id: "rich-text-editor", label: "עורך טקסט עשיר" },
	{ id: "text-ivory", label: "מקטע טקסט — שנהב (ivory)" },
	{ id: "text-stone", label: "מקטע טקסט — אבן (stone)" },
	{ id: "text-navy", label: "מקטע טקסט — כחול כהה (navy)" },
	{ id: "cards", label: "כרטיסים רגילים" },
	{ id: "ordered-cards", label: "כרטיסים ממוספרים" },
	{ id: "profile", label: "תמונת פרופיל" },
	{ id: "gallery", label: "גלריה" },
	{ id: "quote", label: "ציטוט — אלמנט תצוגה" },
	{ id: "header-demo", label: "כותרת האתר — רכיב ממשק" },
	{ id: "sticky-demo", label: "פעולה ניידת — רכיב ממשק" },
	{ id: "faq", label: "שאלות נפוצות" },
	{ id: "offer", label: "הצעה וטופס המחשה" },
	{ id: "contact", label: "קריאה אחרונה לפעולה" },
];
const page = {
	title: "דוגמאות לבלוקים",
	description: "דף המחשה מקומי לרכיבי האתר",
	hero: {
		eyebrow: "פתיח — דוגמה",
		title: "כך נראים הבלוקים של האתר",
		subtitle: "תוכן לדוגמה בלבד, לבדיקת המראה והמבנה בעברית.",
		body: plainTextToRichText(["כל דוגמה מוצגת בנפרד. אפשר לעבור בין הדוגמאות באמצעות תוכן העניינים.", "האיורים והטקסטים הם להמחשה. הטופס מושבת וכל הכפתורים מקשרים למקטעים בדף הזה."]),
		primaryCta: { label: "לצפייה בהצעה לדוגמה", href: "#offer" },
		secondaryCta: { label: "לגלריית ההמחשה", href: "#gallery" },
		visual: { src: "/images/blocks-demo/lesson.svg", alt: "איור לדוגמה של כרטיסיות אותיות", title: "תצוגה לדוגמה", caption: "איור מקומי להמחשת תמונת הפתיח" },
	},
};
const richExample = normalizeRichText([
    { ...plainTextToRichText(["כותרת פנימית לדוגמה"])[0], _key: "heading", style: "h3" },
    { ...plainTextToRichText([""])[0], _key: "emphasis", children: [
        { _type: "span", _key: "a", text: "טקסט רגיל עם ", marks: [] },
        { _type: "span", _key: "b", text: "הדגשה בתוך משפט", marks: ["strong"] },
        { _type: "span", _key: "c", text: " וגם טקסט נטוי", marks: ["em"] },
        { _type: "span", _key: "d", text: " וקישור לדוגמה", marks: ["link"] },
    ], markDefs: [{ _type: "link", _key: "link", href: "#contents" }] },
    { ...plainTextToRichText(["פסקה נוספת, לפני הרשימה. התוכן כאן להמחשה בלבד."])[0], _key: "paragraph" },
    { ...plainTextToRichText(["פריט ראשון", "פריט שני"], true)[0], _key: "bullet-a" },
    { ...plainTextToRichText(["פריט שני"], true)[0], _key: "bullet-b" },
    { ...plainTextToRichText(["צעד ממוספר ראשון"])[0], _key: "number-a", listItem: "number", level: 1 },
    { ...plainTextToRichText(["צעד ממוספר שני"])[0], _key: "number-b", listItem: "number", level: 1 },
    { ...plainTextToRichText(["ציטוט לדוגמה בלבד"])[0], _key: "quote", style: "blockquote" },
    { ...plainTextToRichText(["כותרת קטנה פנימית"])[0], _key: "subheading", style: "h4" },
], () => {}, destination);
const cards = [
	{ title: "כרטיס לדוגמה: היכרות", body: "משפט קצר שמציג רעיון אחד ומאפשר לבדוק את ריווח הטקסט." },
	{ title: "כרטיס לדוגמה: תרגול", body: "כאן מופיע הסבר נוסף לדוגמה, באורך מעט שונה, כדי להמחיש כמה כרטיסים ברצף." },
	{ title: "כרטיס לדוגמה: חזרה", body: "טקסט המחשה שמסיים את קבוצת הכרטיסים." },
];
const faq = [
	{ question: "האם אלה פרטים על תוכנית אמיתית?", answer: "לא. זהו תוכן לדוגמה בלבד שנועד להמחיש את רכיבי האתר." },
	{ question: "מה קורה בלחיצה על הכפתורים?", answer: "הקישורים מעבירים למקטעים בדף. טופס ההמחשה מושבת ואינו שולח פרטים." },
];
const surfaces = [
 { name: "ivory", label: "שנהב", color: "#FBF9F5" },
 { name: "stone", label: "אבן", color: "#E2E7EE" },
 { name: "peach", label: "אפרסק", color: "#FFAB7E" },
 { name: "sage", label: "מרווה", color: "#98D6AE" },
 { name: "butter", label: "צהוב שמש", color: "#FFD45C" },
 { name: "blue", label: "כחול עשיר", color: "#2455BD" },
 { name: "lilac", label: "לילך", color: "#BB9CE5" },
 { name: "navy", label: "נייבי", color: "#00236F" },
] as const;
const primitives = [
 { id: "type-h1", label: "כותרת H1", tag: "h1", text: "לומדים יחד, בקצב שמתאים לכם" },
 { id: "type-h2", label: "כותרת H2", tag: "h2", text: "מנסים, חוזרים וממשיכים" },
 { id: "type-h3", label: "כותרת H3", tag: "h3", text: "רואים דוגמה ומנסים יחד" },
 { id: "type-body", label: "טקסט גוף", tag: "p", text: "משהו עוד לא מסתדר? אפשר לעצור ולנסות שוב. זהו טקסט לדוגמה לבדיקת הקריאה והריווח." },
 { id: "type-caption", label: "כיתוב משני", tag: "p", text: "כאן מופיע כיתוב לדוגמה לצד תמונה." },
] as const;
const extraExamples = [
 ...surfaces.map(s => ({ id: `surface-${s.name}`, label: `רקע — ${s.label}` })),
 ...primitives.map(p => ({ id: p.id, label: p.label })),
 ...(["outline", "soft", "inverse"] as const).map(v => ({ id: `kicker-${v}`, label: `קיקר — ${v}` })),
 ...(["primary", "secondary", "inverse"] as const).flatMap(v => ["rest", "hover", "focus", "disabled"].map(s => ({ id: `button-${v}-${s}`, label: `כפתור ${v} — ${s}` }))),
 { id: "single-card", label: "כרטיס בודד" }, { id: "single-ordered", label: "כרטיס ממוספר בודד" },
 { id: "single-image", label: "תמונה וכיתוב" }, { id: "single-faq", label: "שאלה ותשובה בודדות" },
 { id: "testimonial", label: "מקום לעדות מאושרת" }, { id: "check-item", label: "פריט ברשימה" },
 { id: "name-field", label: "שדה שם" }, { id: "email-field", label: "שדה דוא״ל" },
 { id: "numbered-badge", label: "תג מספר" },
];
---

<!doctype html>
<html lang="he" dir="rtl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
        <LandingFonts />
		<title>{page.title} — הדגמה מקומית</title>
	</head>
	<body style={landingBackgroundStyle(!import.meta.env.DEV)} class="landing-page blocks-demo">
<ParallaxBackground />
		<LandingHeader title="דוגמאות לבלוקים" cta={{ label: "תוכן עניינים", href: "#contents" }} />
		<nav id="contents" class="demo-contents" aria-label="תוכן עניינים לדוגמאות">
			<h2>תוכן עניינים — דוגמאות בלבד</h2>
            <p><a href="/blocks-demo/story">לצפייה בדף דוגמה רציף</a></p>
            <p><a href="/blocks-demo/blocks">לתצוגת בלוקים ועדויות לקוח</a></p>
            <p><a href="/blocks-demo/reading">לטיוטת דף הקריאה — התוכן האמיתי</a></p>
			<ul>{[...examples, ...extraExamples].map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
		</nav>
        <div class="demo-catalog">
            <p class="demo-note">ארבעה סוגי בלוקים באוסף <code dir="ltr">landing_pages.layout</code>. כל מסגרת מציגה בלוק או וריאציה בנפרד. כרטיסים, פרופיל, גלריה ושאלות הם שדות בתוך מקטע תוכן. הקישורים לסכמות מציגים עותק מאומת מ־EmDash; ההגדרה הפעילה מנוהלת במערכת. התמונות כאן הן איורי SVG מקומיים להמחשה; שדות התמונות הראשיים בסכמה דורשים WebP.</p>
            <DemoFrame id="hero-demo" title="פתיח" type="landing_hero" fields="eyebrow, title, subtitle, body, visual_*, cta_*" display={["LandingPageContent"]}>
                <LandingPageContent page={page} />
            </DemoFrame>
            {(["ivory", "stone", "navy"] as const).map((surface) => (
                <DemoFrame id={`text-${surface}`} title={`מקטע תוכן — ${surface}`} type="landing_content_section" fields="kicker, title, background, body, list_style" display={["Section"]}>
                    <Section title="כותרת מקטע לדוגמה" kicker="כותרת קטנה לדוגמה" surface={surface}>
                        <p>פסקה לדוגמה בלבד. כאן אפשר לבדוק את גוון המקטע, קריאות הטקסט והריווח.</p>
                        <p>פסקה נוספת לדוגמה, מוצגת במסגרת משלה.</p>
                    </Section>
                </DemoFrame>
            ))}
            {(["standard", "checklist", "cross_list"] as const).map(listStyle => <DemoFrame id={`rich-text-${listStyle}`} title={`טקסט עשיר — ${listStyle}`} type="landing_content_section" fields="body, list_style" display={["RichTextContent"]}>
                <Section title="פסקאות ורשימות באותו מקטע"><RichTextContent body={richExample} listStyle={listStyle} /></Section>
            </DemoFrame>)}
            <DemoFrame id="rich-text-final" title="הדגשה בתוך פנייה אישית" type="landing_final_cta" fields="body" display={["FinalCta", "RichTextContent"]}>
                <FinalCta><h2>פנייה לדוגמה</h2><RichTextContent body={richExample.slice(1, 3)} /><strong>חתימה לדוגמה</strong></FinalCta>
            </DemoFrame>
            <section id="rich-text-editor" class="demo-frame">
                <h2>בדיקת עריכה בטקסט עשיר</h2>
                <RichTextEditorDemo client:only="react" body={richExample} />
            </section>
            <DemoFrame id="cards" title="מקטע תוכן — כרטיסים רגילים" type="landing_content_section" fields="cards[].title, cards[].body, ordered_cards = false" display={["Section", "CardGrid"]}>
                <Section title="כרטיסים רגילים לדוגמה"><CardGrid items={cards} /></Section>
            </DemoFrame>
            <DemoFrame id="ordered-cards" title="מקטע תוכן — כרטיסים ממוספרים" type="landing_content_section" fields="cards[].title, cards[].body, ordered_cards = true" display={["Section", "CardGrid"]}>
                <Section title="כרטיסים ממוספרים לדוגמה"><CardGrid items={cards} ordered /></Section>
            </DemoFrame>
            <DemoFrame id="profile" title="מקטע תוכן — תמונת פרופיל" type="landing_content_section" fields="profile_image, profile_alt, profile_caption" display={["Section", "ProfileImage"]}>
                <Section title="תמונת פרופיל לדוגמה">
                    <ProfileImage src="/images/blocks-demo/profile.svg" alt="איור של דמות להמחשת תמונת פרופיל" caption="דמות מאוירת לדוגמה בלבד" />
                </Section>
            </DemoFrame>
            <DemoFrame id="gallery" title="מקטע תוכן — גלריה" type="landing_content_section" fields="gallery[].image, gallery[].alt, gallery[].caption" display={["Section", "ImageGallery"]}>
                <p class="demo-note">רקע הגלריה נבחר במפורש ואינו תלוי בנוכחות תמונות.</p>
                <Section title="גלריה לדוגמה" surface="navy">
                    <ImageGallery images={[
                        { src: "/images/blocks-demo/lesson.svg", alt: "איור של כרטיסיות אותיות לדוגמה", caption: "תמונה ראשונה — כרטיסיות להמחשה" },
                        { src: "/images/blocks-demo/practice.svg", alt: "איור של דף תרגול לדוגמה", caption: "תמונה שנייה — דף תרגול להמחשה" },
                    ]} />
                </Section>
            </DemoFrame>
            <DemoFrame id="faq" title="מקטע תוכן — שאלות נפוצות" type="landing_content_section" fields="faq_items[].question, faq_items[].answer" display={["Section", "FaqList"]}>
                <Section title="שאלות נפוצות לדוגמה">
                    <FaqList items={faq} />
                </Section>
            </DemoFrame>
            <DemoFrame id="offer-demo" title="הצעה ותשלום" type="landing_offer" fields="title, body, includes[].text" display={["OfferBlock"]}>
                <p class="demo-note">הכפתור משתמש ב־checkout_url וב־submit_label. אין טופס קליטת לידים בבלוק ההצעה.</p>
                <OfferBlock title="הצעה לדוגמה בלבד" body={plainTextToRichText(["תוכן המחשה להצעה, ללא רכישה או תשלום."])} includes={["פריט ראשון לדוגמה", "פריט שני להמחשת הרשימה"]} cta={{ label: "להמשך הדוגמה", href: "#contact" }} />
            </DemoFrame>
            <DemoFrame id="final-demo" title="קריאה אחרונה לפעולה" type="landing_final_cta" fields="heading, body, signature, cta_label, cta_href" display={["FinalCta"]}>
                <FinalCta kicker={null} cta={{ label: "חזרה לתוכן העניינים", href: "#contents" }}>
                    <h2>כותרת סיום לדוגמה</h2>
                    <p>פסקת סיום לדוגמה שמרכזת את הצעד הבא בתוך הדף.</p>
                    <strong>חתימה לדוגמה</strong>
                </FinalCta>
            </DemoFrame>
            <DemoFrame id="quote" title="ציטוט — אלמנט תצוגה" display={["Section"]}>
                <p class="demo-note">ציטוטים נכתבים בתוך שדה הטקסט העשיר body. כאן מוצג הסגנון בנפרד.</p>
                <Section title="ציטוט לדוגמה"><blockquote><p>ציטוט להמחשת הסגנון בלבד.</p></blockquote></Section>
            </DemoFrame>
            <DemoFrame id="header-demo" title="כותרת האתר — רכיב ממשק" display={["LandingHeader"]}>
                <LandingHeader title="כותרת לדוגמה" cta={{ label: "לתוכן העניינים", href: "#contents" }} />
            </DemoFrame>
            <DemoFrame id="sticky-demo" title="פעולה ניידת — רכיב ממשק" display={["StickyMobileCta"]}>
                <p class="demo-note">הרכיב מוצג כאן בתוך המסגרת כדי לבדוק אותו בנפרד.</p>
                <StickyMobileCta cta={{ label: "לתוכן העניינים", href: "#contents" }} />
            </DemoFrame>
            {surfaces.map(s => <DemoFrame id={`surface-${s.name}`} title={`רקע — ${s.label} (${s.color})`} type="landing_content_section" fields="background — סוג רקע שנבחר לכל מקטע באדמין EmDash" display={["Section"]}>
                <Section title="רואים דוגמה ומנסים יחד" kicker="בואו נתחיל מהבסיס" surface={s.name}><p>משהו עוד לא מסתדר? אפשר לעצור ולנסות שוב. כאן בודקים איך הטקסט נראה על הרקע הזה.</p><CardGrid items={[cards[0]]} /></Section>
            </DemoFrame>)}
            {primitives.map(({ id, label, tag: Tag, text }) => <DemoFrame id={id} title={label} display={["Section"]}><Tag class={id}>{text}</Tag></DemoFrame>)}
            {(["outline", "soft", "inverse"] as const).map(variant => <DemoFrame id={`kicker-${variant}`} title={`קיקר — ${variant}`} display={["Kicker"]}><div class:list={["primitive-surface", variant === "inverse" && "primitive-surface--inverse"]}><Kicker variant={variant}>בואו תראו איך זה נראה</Kicker><h2>כותרת לדוגמה מתחת לקיקר</h2></div></DemoFrame>)}
            {(["primary", "secondary", "inverse"] as const).flatMap(variant => ["rest", "hover", "focus", "disabled"].map(state => <DemoFrame id={`button-${variant}-${state}`} title={`כפתור ${variant} — ${state}`} display={["LandingPageContent"]}><div class:list={["primitive-surface", variant === "inverse" && "primitive-surface--inverse"]}><button type="button" disabled={state === "disabled"} class:list={["button", `button--${variant}`, state === "hover" && "button--hover", state === "focus" && "button--focus"]}>לפרטי הדוגמה</button></div></DemoFrame>))}
            {ctaPresets.map(({ style, label }) => <DemoFrame id={`cta-style-${style}`} title={`סגנון כפתור — ${label}`} type="landing_offer" fields="cta_style — סגנון כפתור בפתיח, בהצעה ובסיום" display={["OfferBlock", "FinalCta"]}>
                <OfferBlock title="הצעה לדוגמה" body={plainTextToRichText(["סגנון הכפתור נבחר באדמין EmDash."])} includes={["תוכן המחשה בלבד"]} cta={{ label: "כן אני רוצה את הקורס!", href: "#contents", style }} />
                <FinalCta cta={{ label: "כן אני רוצה את הקורס!", href: "#contents", style }}><h2>סיום לדוגמה</h2><p>אותה בחירה נשמרת גם בכפתור הסיום.</p></FinalCta>
            </DemoFrame>)}
            <DemoFrame id="single-card" title="כרטיס בודד" type="landing_content_section" fields="cards[].title, cards[].body" display={["CardGrid"]}><CardGrid items={[cards[0]]} /></DemoFrame>
            <DemoFrame id="single-ordered" title="כרטיס ממוספר בודד" type="landing_content_section" fields="cards[], ordered_cards" display={["CardGrid"]}><CardGrid items={[cards[0]]} ordered /></DemoFrame>
            <DemoFrame id="numbered-badge" title="תג מספר — בנפרד" display={["CardGrid"]}><span class="info-card__index">1</span></DemoFrame>
            <DemoFrame id="single-image" title="תמונה וכיתוב" type="landing_content_section" fields="gallery[].image, alt, caption" display={["ImageGallery"]}><ImageGallery images={[{ src: "/images/blocks-demo/lesson.svg", alt: "כרטיסיות מאוירות להמחשה", caption: "רואים דוגמה — איור מקומי" }]} /></DemoFrame>
