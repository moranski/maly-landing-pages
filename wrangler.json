{
	"name": "maly-landing-pages",
	"compatibility_date": "2026-09-27",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/worker.ts",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "maly-landing-pages"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "maly-landing-pages-media"
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
